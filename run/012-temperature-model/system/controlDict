/*------------------------------------------------------------------------------

system/controlDict

  - select solver
  - start and stop of calculation
  - time step size
  - saving frequency
  - output format, precision, compression and time naming
  - allows run-time changes
  - species-transport numerical controls

------------------------------------------------------------------------------*/
FoamFile{version 2.0;  format ascii;  class dictionary; object controlDict;}
/*----------------------------------------------------------------------------*/

application       rhoFixedFlowFoam;

startFrom         startTime;
startTime         0;

stopAt            endTime;
endTime           16.0;            /* flow through time is ~ 7.3 s */

deltaT            0.001;           /* plan section 13: 1 ms; CFL ~ 0.12 */

writeControl      timeStep;
writeInterval     500;

purgeWrite        0;

writeFormat       binary;          /* exact restarts of the mass ledger */
writeCompression  off;

timeFormat        general;
timePrecision     6;

runTimeModifiable true;

speciesTransport {

  tolerance          1.0e-5;       /* outer loop: residual and settled regimes */
  nCorr              10;           /* loose correctors, then Y_PbI2_gFinal */
  writeFrozenFields  no;           /* carrier read from 0, never written */
}
