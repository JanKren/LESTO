/*------------------------------------------------------------------------------

system/fvSolution

  - select linear solvers
  - solver tolerances
  - under-relaxation factors (none: a paired species is never relaxed)

  Loose outer correctors plus one tight final solve (Y_PbI2_gFinal, relTol
  0): the solver defect of the ledger stays at the 1e-12 level at a
  fraction of the cost of tight solves everywhere.

------------------------------------------------------------------------------*/
FoamFile{version 2.0;  format ascii; class dictionary; object fvSolution;}
/*----------------------------------------------------------------------------*/

solvers {

  Y_PbI2_g {
    solver          GAMG;
    tolerance       1e-8;
    relTol          0.1;
    smoother        GaussSeidel;

    directSolveCoarsest   yes;
  }

  Y_PbI2_gFinal {
    solver          GAMG;
    tolerance       1e-12;
    relTol          0;
    smoother        GaussSeidel;

    directSolveCoarsest   yes;
  }

  Y_PbI2_s {
    solver          diagonal;
  }
}
