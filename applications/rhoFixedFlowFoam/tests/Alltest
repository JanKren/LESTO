#!/bin/bash
#------------------------------------------------------------------------------
#
# tests/Alltest
#
# PURPOSE
#
# Runs the acceptance tests of rhoFixedFlowFoam for one or more milestones of
# doc/phase-change-plan.md and prints one PASS/FAIL/NOTRUN line per
# criterion.  Every milestone re-runs the M0 regression gate.
#
# Usage
#
#   tests/Alltest [-fresh] <milestone> [<milestone> ...]
#
#   M0     standalone g++ test of the PbI2-He correlation; build plumbing
#          (tests/build: Allwmake versions, GEMS3K bridge and xGEMS opt-in,
#          stamps and wclean, generated gemsConfig.H and xgemsConfig.H,
#          ldd, 0 warnings, v2606); the regression gate (tests/regression:
#          008/009/010/011 logs and 010's written fields vs the pristine
#          build of the tag 0.1 of the main branch, and the out_excerpts)
#   M1     frozen-carrier I/O (tests/frozenCarrier: writeFrozenFields no,
#          restarts from Y_* only in serial and on 4 ranks) and the gate
#   M2     exchange core, temperature model, release, ledger (tests/
#          phaseChange: closed boxes, channels incl. long release windows
#          up to M8 scale, pipe in serial and on 4 ranks, restarts incl.
#          re-decomposed, collated, single-WALL-face and function-object
#          written ones, with writeFrozenFields yes and with a changed
#          interface or release schedule, rounded boundary values of
#          the gas and the carrier, start-up and per-step checks (incl.
#          the conservative convection scheme), halfCell on ranks without
#          WALL faces and its refusal with a scaled area, an interface
#          patch not named WALL, model mock, run/012, an unpaired gas in
#          a phase-change model; plan sections 12, 14, 15, 16, 17 and 31)
#          and the gate
#   M3     outputs and diagnostics (tests/profiles: g++ test of the
#          binning and the onset search; axial profiles in mol/m with
#          exact overlap binning integrating to the inventories, also for
#          bins that do not cover the mesh; the pipe on 4 ranks, simple
#          and hierarchical, equal to serial with a converged outer loop;
#          T_dep of a synthetic ramp deposit against the analytic crossing
#          in both search modes, with an upstream spike and searchFrom;
#          bins that cut cells against the exact overlap of the native
#          profile; profile times, restarts, writes of function objects
#          between two steps and no partial time directories;
#          mDep_ with areaMultiplier 2 and areaPerVolume layer; exch_;
#          run/012 with profiles; the restart verdict with recomputed
#          patch values; plan section 18; the uneven split of M3.2c is a
#          carry-over of the M3 sign-off) and the gate
#   M5     Hertz-Knudsen-Schrage with p_v tables, inventory samples and
#          their removal (tests/hks: closed boxes at 700 K (bare wall,
#          also over 50 steps near equilibrium, CAPPED, ample condensate,
#          below Y_eq, halfCell), the channel with an inventory sample
#          removed at 0.25 s (nCorr 3 and 0, binary restarts across the
#          removal, 4 ranks simple and uneven, the removal on the exact
#          clock, the removed sample dropped and re-added, a release
#          sample added in front, the recommended loose solves), the pipe
#          of run/013 (re-decomposed and reconstructed restarts; 25 steps
#          at its own settings) and its out_excerpt, the tables
#          (testVapourPressureTable.C, and make_pv_table.py from the
#          sources: NOTRUN without them), start-up and restart refusals,
#          the warning about inputs of the other model, the regime
#          choice of a small reservoir (independent of nCorr, the guard
#          in both directions, complementarity recomputed from the
#          fields), an ascii re-decomposed restart, the guard acting on
#          the total of the missed masses, collated restarts after
#          reconstructPar and onto another number of ranks, the geometry
#          record within the point rounding of both runs (an ascii mesh
#          reconstructed, a sample far from the origin) but never beyond
#          what a selection changed by one cell causes (a moved and a
#          swapped selection refused on an ascii mesh of round
#          coordinates), acceptance 2 as written, a sample next to a colder
#          wall at several nCorr (the guard re-solving the matrix of the
#          recorded solve; the bounded law of the wall elements recomputed
#          from the fields), same-decomposition restarts under the
#          masterUncollated handler and the collated one with two IO
#          ranks, and the carry-overs of the M3 sign-off: wallPlusGas
#          without the gas of the samples, the significance of T_dep, the
#          profile times of a restart with another deltaT, and the uneven
#          3-rank split M3.2c of tests/profiles (unless M3 runs it); plan
#          sections 20 to 24) and the gate
#   M4     paper-mode carrier, layer distance, code-to-code case run/014
#          (tests/paperMode: setFrozenCarrier on the pipe and on a wedge,
#          serial and decomposed (also a single inlet face on a rank), on
#          a wedge not extruded along the axis and refused on one whose
#          wall faces are tilted, on a reversed axis, an outlet named as
#          the inlet and a radius below the wall, its continuity to 1e-15
#          and its negative evidence, the T-Flows wall table and its count
#          line, -check and the written instance of a case that has run;
#          the layer counts of both rules on the pipe; layer distance on a
#          channel in serial and on 4 ranks with the nearest wall faces on
#          other ranks (closure, mDep_ = the wall inventory, serial =
#          parallel; faces with the elements of two other ranks summed in
#          the same order in two runs; maps that run both ways between two
#          ranks, on the channel, the pipe and the tetrahedral pipe), the
#          pipe of run/014 on four 4-rank splits, binary restarts (mw_ = the
#          deposits), refusals,
#          profiles, model HKS in serial and on 4 ranks (the temperature
#          of the nearest faces pulled across ranks), several interface
#          patches meeting at corners in both boundary orders, a layer cell
#          touching the wall only by an edge whose wall faces lie on
#          another rank, a tetrahedral pipe (gmsh) in serial and on 4
#          ranks; the closure without drift on the pipe at large steps; the
#          face-flux correction of the transport matrix in flux form (no
#          explicit remainder on the pipe, both layer rules, and the
#          transport identity of the cell defects at exact zero, a copy of
#          the sources with the source form built as its negative control);
#          the mole-fraction monitor from the carrier's p/(R T); the exactly
#          rescaled inflow of a wedge with sectorAngle; run/014's
#          out_excerpt; the provenance of its T-Flows inputs; the v2606
#          compile of the solver and the utility; plan sections 25 to 27,
#          29 and 33; about 25-35 min) and the gate
#   M4long the code-to-code runs of acceptance 3-5 (Fig. 9 identity, the
#          solid profiles of t_ev 6 and 15 s, Table 2 for both layer
#          rules with the gate restated by the researcher, max(2 K,
#          dT_bin)), the closure of the runs made with the current
#          sources without drift (M4.17; a revalidated run is not gated),
#          the positions of Figs. 9-10 against run/014 and the T-Flows
#          parameter set (not a gate), and the key of a run, which follows
#          the mesh and the set-up functions (M4.20); hours on 16 cores:
#          M4LONG_JOBS runs of M4LONG_RANKS ranks, default 2 x 8;
#          M4LONG_RUNS selects runs, 'ended' only evaluates; a run that
#          ended under older sources is run again, or revalidated by a probe
#          only with M4LONG_REVALIDATE=yes (then named so in its criterion
#          lines); a run that did not end is NOTRUN with its cost and is
#          left prepared; tests/paperMode/longRuns) and the gate; not part
#          of 'all'
#   M9     the GEMS3K backend of the HKS law (tests/gems: a copy of the
#          sources built with the bridge in the work area, the default
#          solver staying bridge-free; equilibrium GEMS refused without
#          the bridge; mode frozen on the 1150 -> 450 K channel against the
#          5 K table per element, deterministic in a restart and on 4
#          ranks; mode local on the 1000 -> 400 K ramp channel: the guards
#          of every element recomputed from the fields, 0 failures, the
#          cost of a warm call with the load (and a load sampler that never
#          outlives its script), 4 ranks with 4 engines and 4 logs, the
#          deposit profile against the table run, paper mode refused unless
#          allowNonPhysicalCarrier; speciation lagged as a separate run;
#          with a fault-injecting bridge the engine re-created after
#          GEMSB_ERR_FATAL in both modes and unusable results of converged
#          calls counted as failures; updateInterval and its restarts,
#          which keep the schedule of the time index and restore the
#          lagged state; start-up refusals and warnings (unknown keys, the
#          keys of the other mode); run/015 and its out_excerpt, exactly
#          with the bridge that wrote it, with another bridge its start-up
#          and step 1 (the rest NOTRUN); a restart in mode local; per-rank
#          log directories, named for every rank; 64-bit counts; the
#          closure and the solver defect of every run, and a ledger with a
#          value that is not finite refused; plan sections 32 and 35; 2 min
#          on a quiet machine, about 10 on a busy one) and the gate
#   M7     verification (tests/verification; plan sections 6 M7 and 33):
#          the Graetz-Robin problem of acceptance 1 (graetzRobin: the
#          extended Graetz problem with a first-order wall uptake on
#          blockMesh wedges of 32 to 256 radial cells, wallResistance none
#          and halfCell, Bi 1 and 50, Gauss linear and SuperBee; GCI,
#          observed orders, the discrete mode of the documented scheme and
#          a time-accurate control; about 20 min on 4 cores; runs reused
#          while the solver, the helper, the scripts and the functions that
#          set them up are unchanged; and, without runs, the checks of a
#          fit or a closure that is not finite, told apart from a crash,
#          and the keys of the runs) and the gate
#   M7long the long runs of M7 (tests/verification: pipeMeshes, the h/2
#          first-layer and the axial x2 meshes of the test mesh, and
#          longStudies): acceptance 3 on the 007 carrier (run/012 and run/013
#          at dt 4, 2 and 1 ms to 16 s), acceptance 2 on the paper-mode
#          carrier (h vs h/2 at 106 mL/min, layer faceCells: the flux form
#          with none and with halfCell gated, the volumetric form reported),
#          the axial x2 study (gated by the criterion the second M7 study
#          proposed, M7LONG_AXIAL_GATE=no reports it), and acceptance 3 on
#          run/014 (dt 4, 2 and 1 ms to 30 s; the intermediate-time error
#          reported); hours on 16 cores: M7LONG_JOBS runs of M7LONG_RANKS
#          ranks, default 2 x 8 (on a machine with hyperthreading bind
#          them to distinct physical cores, e.g. M7LONG_CPUS=0-15; readme);
#          runs keyed, reused, resumed; M7LONG_RUNS
#          selects runs ('ended' only evaluates); a run that ended under
#          older sources is kept, and run again when selected or revalidated
#          by a probe only with M7LONG_REVALIDATE=yes (then named so in its
#          criterion lines); the driver's own mechanics (the verdicts of
#          its criteria with a stand-in checker; a resumed run of the 007
#          carrier, about 2 min); and the gate; not part of 'all'
#   M10a  independent species pairs, element accounting, shared samples,
#          Chapman-Enskog diffusion and external-data generator checks
#   M10b  homogeneous gas equilibrium, species/element ledgers and restart
#   M10c  optional GEMS frozen/local gas engines, ABI and per-cell qualification
#   M10d  shared metal condensates, reactive BiI wall channels and Q2 sources
#   all    every milestone implemented so far: M0 M1 M2 M3 M4 M5 M7 M9 M10a M10b M10c M10d (not
#          M4long, M7long)
#
#   -fresh re-run the cached pristine reference cases too
#
# Before the tests the solver is built from scratch (wclean, then
# ./Allwmake), so that every source file is compiled and the 0-warnings
# check (BUILD) is never vacuous.  All cases run in the git-ignored
# tests/work/<version>-<WM_OPTIONS>/.
#
# Completeness.  Each test script records its own criteria.  A script that
# stops early (e.g. the pristine build or decomposePar failed) is reported
# as a FAIL, and every criterion id this invocation must produce is checked
# at the end: a missing one is a FAIL too.  The criterion SELF tests exactly
# this mechanism, with a gate whose pristine revision does not exist.  The
# criterion LIST checks the converse: every criterion id recorded (PASS or
# NOTRUN) is one this invocation expects, so that a new criterion cannot
# be left out of the lists below (plan section 35, item U: M7.1n, M7.1o,
# M7.6a and M7.6b were recorded but not expected, and their absence would
# not have failed the run).
#
# Exit status: 0 when every expected criterion was recorded and none
# failed, 1 otherwise, 2 on a usage or environment error.  A NOTRUN
# criterion (M0.4, compile on v2606, under another OpenFOAM version; M5.4b,
# the tables from their sources, on a machine without thermo.inp or the
# pinned T-Flows revision; M4.6 without LESTO_OPENFOAM_V2606, M4.12
# without the T-Flows revision; the M4long and M7long runs that did not
# end; M9.3b, the cost of a warm GEMS3K call, when it is slower than 70 us
# on a busy machine (a 1-minute load of 4 or more); the first line of M9.8,
# run/015's out_excerpt, with a bridge other than the one that wrote it
# (its start-up and step 1 compared, the rest NOTRUN); every M9 criterion
# but M9.0, M9.1, M9.14 and the second line of M9.3b without a GEMS3K
# bridge) does not fail the run but is listed in the summary.
#
#------------------------------------------------------------------------------
source "$(dirname "${BASH_SOURCE[0]}")/functions"

usage() {
  sed -n '/^# Usage/,/^# Before/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'
  exit 2
}

fresh=
milestones=()
for arg in "$@"
do
  case "$arg" in
    -fresh) fresh=-fresh ;;
    M0|M1|M2|M3|M4|M4long|M5|M7|M7long|M9|M10a|M10b|M10c|M10d) milestones+=("$arg") ;;
    all) milestones+=(M0 M1 M2 M3 M4 M5 M7 M9 M10a M10b M10c M10d) ;;
    -h|-help|--help) usage ;;
    *) echo "Unknown milestone or option: $arg" >&2; usage ;;
  esac
done
[ ${#milestones[@]} -gt 0 ] || usage

want() {
  local m
  for m in "${milestones[@]}"
  do
    [ "$m" = "$1" ] && return 0
  done
  return 1
}

requireOpenFOAM
: > "$RESULTS"
start=$(date +%s)

echo "rhoFixedFlowFoam acceptance tests: ${milestones[*]}" \
     "(OpenFOAM $WM_PROJECT_VERSION, $(git -C "$REPO_DIR" rev-parse \
     --abbrev-ref HEAD) $(git -C "$REPO_DIR" rev-parse --short HEAD);" \
     "work directory $WORK_DIR)"

