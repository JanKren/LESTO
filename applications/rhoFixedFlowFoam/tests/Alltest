#------------------------------------------------------------------------------
# Every milestone: self-test of the completeness check.  The gate is run
# with a pristine revision that does not exist, into a separate results
# file: it must stop early, runScript must record that as a FAIL, and
# expectResults must record a FAIL for each of its 5 criterion ids and
# report failure.  Nothing of the real gate's work directory is changed
# (the gate stops at the pristine build, before any run).
#------------------------------------------------------------------------------
selfTest() {
  local dir=$WORK_DIR/selftest
  rm -rf "$dir"
  mkdir -p "$dir"
  (
    RESULTS=$dir/results
    : > "$RESULTS"
    export LESTO_TEST_RESULTS=$RESULTS
    export PRISTINE_REF=lesto-selftest-no-such-revision
    runScript "$TESTS_DIR/regression/Allrun" && exit 1
    expectResults M0.1a:4 M0.1b:1 M0.1c:2 M0.1d:1 M0.2:1 && exit 1
    exit 0
  ) > "$dir/log" 2>&1 || return 1

  grep -q '^FAIL   regression .*stopped early' "$dir/results" \
    && [ "$(grep -c '^FAIL' "$dir/results")" -eq 6 ] \
    && ! grep -q '^PASS' "$dir/results"
}

check SELF "a test script that stops early fails Alltest (self-test:\
 gate with a missing pristine revision, $WORK_DIR/selftest)" selfTest

#------------------------------------------------------------------------------
# Every milestone: the cache keys of the gate's pristine runs and of the
# dynamicCode seed follow the run/ inputs (caseInputsSum).  It is evaluated
# on a stand-in run/ directory of links to the real inputs (the same sum as
# run/ itself), then after replacing one link by a changed copy: a
# dictionary that makeCase copies, and the linked carrier field 0/T.  Only
# the stand-in directory is changed, never run/.
#------------------------------------------------------------------------------
cacheTest() {
  local dir=$WORK_DIR/cachetest n src dst f sumRun sumLinks sumDict sumCarrier
  rm -rf "$dir"
  for n in 008 009 010 011
  do
    src=$(runCaseDir "$n") || return 1
    dst=$dir/run/$(basename "$src")
    mkdir -p "$dst/system" "$dst/constant" "$dst/0"
    for f in "$src"/system/* "$src"/constant/*Properties "$src"/0/*
    do
      ln -s "$(readlink -f "$f")" "$dst/${f#$src/}"
    done
  done

  # changeCopy <link>: replace the link by a copy of its target, one line more
  changeCopy() {
    local target
    target=$(readlink -f "$1")
    rm -f "$1"
    cp "$target" "$1" && echo "// changed" >> "$1"
  }

  sumRun=$(caseInputsSum 008 009 010 011)
  sumLinks=$(RUN_DIR=$dir/run caseInputsSum 008 009 010 011)
  dst=$(RUN_DIR=$dir/run runCaseDir 010)
  changeCopy "$dst/system/controlDict" || return 1
  sumDict=$(RUN_DIR=$dir/run caseInputsSum 008 009 010 011)
  changeCopy "$dst/0/T" || return 1
  sumCarrier=$(RUN_DIR=$dir/run caseInputsSum 008 009 010 011)
  rm -rf "$dir"

  echo "input sums: run/ $sumRun, links $sumLinks, changed controlDict" \
       "$sumDict, changed 0/T $sumCarrier"
  [ -n "$sumRun" ] && [ "$sumLinks" = "$sumRun" ] \
    && [ "$sumDict" != "$sumRun" ] && [ "$sumCarrier" != "$sumDict" ] \
    && [ "$sumCarrier" != "$sumRun" ]
}

check CACHE "the cache keys of the pristine runs and the dynamicCode seed\
 change with a copied dictionary and with the linked carrier of run/008-011"\
 cacheTest

#------------------------------------------------------------------------------
# Every milestone: every criterion id recorded (PASS or NOTRUN; a FAIL fails
# the run anyway, and a script that stops early records one named after its
# directory) is in the expected list of this invocation (plan section 35,
# item U).  unexpectedResults <results file> <id>:<count> ... prints those
# ids; the check runs it on the results of this invocation and, as its own
# control, on a stand-in file with one id more (M7.9z), which it must name.
#------------------------------------------------------------------------------
unexpectedResults() {
  local file=$1 id found=
  shift
  for id in $(awk '$1 != "FAIL" {print $2}' "$file" | sort -u)
  do
    case " $* " in
      *" $id:"*) ;;
      *) found+="${found:+ }$id" ;;
    esac
  done
  echo "$found"
}

listTest() {
  local dir=$WORK_DIR/listtest unexpected control
  rm -rf "$dir"
  mkdir -p "$dir"
  unexpected=$(unexpectedResults "$RESULTS" "${expected[@]}")
  { cat "$RESULTS"; echo "PASS   M7.9z      a criterion of no list"; } \
    > "$dir/results"
  control=$(unexpectedResults "$dir/results" "${expected[@]}")
  echo "recorded but not expected: ${unexpected:-none}; the control with\
 M7.9z added: ${control:-none}"
  [ -z "$unexpected" ] && [ "$control" = "M7.9z" ]
}

listOut=$(listTest)
listStatus=$?
check LIST "every criterion id recorded is expected by this invocation\
 (plan section 35, item U): $listOut" [ $listStatus -eq 0 ]

#------------------------------------------------------------------------------
# Summary: every expected criterion recorded, none failed
#------------------------------------------------------------------------------
expectResults "${expected[@]}"

echo
echo "Summary ($(( ($(date +%s) - start) / 60 )) min; $RESULTS)"
cat "$RESULTS"

nFail=$(grep -c '^FAIL' "$RESULTS")
nPass=$(grep -c '^PASS' "$RESULTS")
nNotRun=$(grep -c '^NOTRUN' "$RESULTS")
echo "$nPass passed, $nFail failed, $nNotRun not run"

[ "$nFail" -eq 0 ] && [ "$nPass" -gt 0 ]

