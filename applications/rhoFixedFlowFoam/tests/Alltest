#------------------------------------------------------------------------------
# The solver under test, built from scratch
#------------------------------------------------------------------------------
buildOk() {
  local log=$WORK_DIR/log.Allwmake s n=0
  for s in $(solverSources) $(utilitySources)
  do
    compiled "$s" "$log" || { echo "$s was not compiled ($log)"; return 1; }
    n=$((n + 1))
  done
  [ $n -gt 1 ] && [ "$(countWarnings "$log")" -eq 0 ] && [ -x "$SOLVER_EXE" ] \
    && [ -x "$FOAM_USER_APPBIN/setFrozenCarrier" ]
}

echo "Building the solver from scratch (wclean, ./Allwmake)"
if buildSolver
then
  check BUILD "wclean + Allwmake of the solver and of the utility\
 setFrozenCarrier: every source of their Make/files compiled, 0 warnings\
 ($WORK_DIR/log.Allwmake)" buildOk
else
  result BUILD FAIL "Allwmake of the solver failed ($WORK_DIR/log.Allwmake)"
  exit 1
fi

#------------------------------------------------------------------------------
# M0 only: standalone test and build plumbing
#------------------------------------------------------------------------------
if want M0
then
  if g++ -std=c++17 -Wall -Wextra "$TESTS_DIR/testDiffusivity.C" \
    -o "$WORK_DIR/testDiffusivity" > "$WORK_DIR/log.testDiffusivity" 2>&1 \
    && "$WORK_DIR/testDiffusivity" >> "$WORK_DIR/log.testDiffusivity" 2>&1
  then
    check M0.0 "g++ testDiffusivity (PbI2-He reference values), 0 warnings" \
      [ "$(countWarnings "$WORK_DIR/log.testDiffusivity")" -eq 0 ]
  else
    result M0.0 FAIL "testDiffusivity ($WORK_DIR/log.testDiffusivity)"
  fi

  runScript "$TESTS_DIR/build/Allrun"
fi

