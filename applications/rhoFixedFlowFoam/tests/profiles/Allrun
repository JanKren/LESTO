#------------------------------------------------------------------------------
# M3.3: synthetic ramp deposit, T_dep against the analytic crossing
#------------------------------------------------------------------------------
# tdepCase <id text> <case> <observable> <spike> <searchFrom|-> <expected
# modes: 'fromInlet:<native>:<coarse> fromPeak:...' computed here>
rampOk() {
  local c=$1 observable=$2 spike=$3 from=$4 mode set expected out
  local status=0 text=""
  grep -q '^End' "$c/log" || { echo "run failed ($c/log)"; return 1; }
  for mode in fromInlet fromPeak
  do
    for set in native coarse
    do
      if [ "$mode" = fromInlet ] && [ "$from" != - ]
      then
        expected=$($CHECKS rampExpected $mode $observable $set $spike "$from")
      else
        expected=$($CHECKS rampExpected $mode $observable $set $spike)
      fi
      out=$($CHECKS tdep "$c" $set $mode "$expected" 1e-9) || status=1
      text="$text $mode/$set ${out#*: };"
    done
  done
  echo "$text"
  return $status
}

