# clockCase <case> <timePrecision> <endTime> <writeInterval> [<start time>
# <window start>]: the channel started at t = 10 s (its 0 renamed; or at
# <start time>) with dt = 0.22 ms and the release window 10.0001 s (or
# <window start>) over 0.0198 s (it starts and ends inside a step)
clockCase() {
  local t0=${5:-10} window=${6:-10.0001}
  blockCase channel "$1" \
    && mv "$1/0" "$1/$t0" \
    && setControl "$1" startTime "$t0" \
    && setControl "$1" endTime "$3" \
    && setControl "$1" deltaT 0.00022 \
    && setControl "$1" writeInterval "$4" \
    && setControl "$1" timePrecision "$2" \
    && edit "$1/constant/thermochemistryProperties" \
         "s/^(    startTime +)3e-4;/\\1$window;/; s/^(    duration +)0.0405;/\\10.0198;/" \
         "startTime +$window;"
}

# longWindow <case> <duration> <deltaT> <endTime>: the channel with a
# release window of <duration> from 0.3 ms, no field output
longWindow() {
  blockCase channel "$1" \
    && setControl "$1" endTime "$4" \
    && setControl "$1" deltaT "$3" \
    && setControl "$1" writeInterval 10000000 \
    && edit "$1/constant/thermochemistryProperties" \
         "s/^(    duration +)0.0405;/\\1$2;/" "duration +$2;"
}

