# the carrier generator, rebuilt when its source or OpenFOAM changes
buildMakeCarrier() {
  local key
  key="$WM_PROJECT_DIR $(cat "$PC_SRC"/makeCarrier/makeCarrier.C \
    "$PC_SRC"/makeCarrier/Make/* | md5sum | cut -d' ' -f1)"
  if [ -x "$MAKE_CARRIER" ] \
    && [ "$(cat "$PC_DIR/bin/key" 2>/dev/null)" = "$key" ]
  then
    return 0
  fi
  rm -rf "$PC_DIR/makeCarrier" "$PC_DIR/bin"
  mkdir -p "$PC_DIR/bin"
  cp -r "$PC_SRC/makeCarrier" "$PC_DIR/makeCarrier"
  (cd "$PC_DIR/makeCarrier" && FOAM_USER_APPBIN=$PC_DIR/bin wmake) \
    > "$PC_DIR/log.makeCarrier" 2>&1 || {
      echo "Building makeCarrier failed, see $PC_DIR/log.makeCarrier" >&2
      return 1
    }
  echo "$key" > "$PC_DIR/bin/key"
}

# blockCase <template> <destination> [<command> ...]: copy, run the optional
# command in the copy (e.g. to edit blockMeshDict or carrierDict), blockMesh,
# carrier
blockCase() {
  local template=$1 dst=$2
  shift 2
  rm -rf "$dst"
  cp -r "$PC_SRC/$template" "$dst" \
    && (cd "$dst" && { [ $# -eq 0 ] || "$@"; } \
        && blockMesh > log.blockMesh 2>&1 \
        && "$MAKE_CARRIER" > log.makeCarrier 2>&1) \
    || { echo "Setting up $dst failed" >&2; return 1; }
  touch "$dst/case.foam"
}

# edit <file> <sed expression> <pattern that must match afterwards>
edit() {
  sed -i -E "$2" "$1" && grep -q -E "$3" "$1" \
    || { echo "Editing $1 with '$2' failed" >&2; return 1; }
}

# blockCase hooks (run inside the copied case)
wallAt450K() {
  echo 'Twall     450;' >> system/carrierDict
}
inclineTop() {
  edit system/blockMeshDict \
    's/\(0\.01 57\.46e-6 (0|1e-3)\)/(0.01 80e-6 \1)/g; s/\(0 +57\.46e-6 (0|1e-3)\)/(0 40e-6 \1)/g' \
    '\(0 40e-6 1e-3\)' \
    && [ "$(grep -o -E '\((0\.01 80|0 40)e-6 (0|1e-3)\)' system/blockMeshDict \
         | wc -l)" -eq 4 ]
}
# the interface patch named 'wall': no patch WALL in the mesh
interfaceNamedWall() {
  edit system/blockMeshDict 's/^  WALL( +\{type patch;)/  wall\1/' \
    '^  wall +\{type patch;' \
    && sed -i -E 's/INLET\|OUTLET\|WALL\|TOP/INLET|OUTLET|wall|TOP/' 0/* \
    && ! grep -q WALL 0/* \
    && edit constant/thermochemistryProperties \
         's/^(  patches +)\(WALL\);/\1(wall);/' '^  patches +\(wall\);'
}

# expectFatal <id> <text> <case> <message>: the run fails with the message
expectFatal() {
  local id=$1 text=$2 c=$3 message=$4
  if runSerial "$c" "$SOLVER_EXE"
  then
    result "$id" FAIL "$text: the run did not stop ($c/log)"
  elif grep -q -F -- "$message" "$c/log"
  then
    result "$id" PASS "$text: stops with '$message'"
  else
    result "$id" FAIL "$text: stopped without '$message' ($c/log)"
  fi
}

# decomposeWith <case> <n> <method and coeffs> [decomposePar options]
decomposeWith() {
  local c=$1 n=$2 method=$3
  shift 3
  cat > "$c/system/decomposeParDict" <<EOF
FoamFile{version 2.0; format ascii; class dictionary; object decomposeParDict;}

numberOfSubdomains $n;
$method
EOF
  (cd "$c" && decomposePar -force "$@" > log.decomposePar 2>&1)
}

# processor patch counts of the ranks of a decomposed case
processorPatches() {
  local d
  for d in "$1"/processor*
  do
