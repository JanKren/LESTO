# removeSamples <thermochemistryProperties>: the file without its samples
removeSamples() {
  python3 - "$1" <<'PYEOF'
import re, sys
p = sys.argv[1]
s = open(p).read()
new, n = re.subn(r'\nsamples \{.*?\n\}\n', '\n', s, flags=re.S)
if n != 1:
    sys.exit(f'No samples dictionary in {p}')
open(p, 'w').write(new)
PYEOF
}

# addSample <thermochemistryProperties> <startTime>: a second sample 'late'
# of the channel, 1e-6 mol over 0.02 s in the 40 cells x 50-60 mm, y 2.0-2.8
# mm (disjoint from the layer and from the sample 'boat')
addSample() {
  python3 - "$1" "$2" <<'PYEOF'
import sys
p, start = sys.argv[1:]
s = open(p).read()
i = s.find('\nsamples {')
if i < 0:
    sys.exit(f'No samples dictionary in {p}')
i += len('\nsamples {')
s = s[:i] + f"""
  late {{
    pair       PbI2_g;
    selection  {{
      late {{ action use; source box; box (0.05 0.002 -1) (0.06 0.0028 1); }}
    }}
    mode       release;
    amount     1e-6;
    startTime  {start};
    duration   0.02;
  }}""" + s[i:]
open(p, 'w').write(s)
PYEOF
}

