  closure=$($CHECKS closure "$dat" 1e-13)
  s3=$?
  check M2.2i "channel from 1000 s, window 1000.0001 s over 0.0198 s:\
 ${perStep#*: }; ${total#*: }; ${closure#*: }" \
    eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $s3 -eq 0 ]'
else
  result M2.2i FAIL "channel from 1000 s failed ($CLOCK1000/log)"
fi

if grep -q '^End' "$CHMW/log"
then
  out=$($CHECKS sameAsColumn "$CHMW/$BALANCE" wall \
    "$CHMW/postProcessing/wallDeposit/0/surfaceFieldValue.dat" 1e-12)
  check M2.2j "surfaceFieldValue areaIntegrate(mw_PbI2_s) on WALL every\
 step (fields written every 50 steps) vs the ledger's wall inventory:\
 ${out#*: }" [ $? -eq 0 ]
else
  result M2.2j FAIL "channel with the deposit function object failed\
 ($CHMW/log)"
fi

# M2.5a/b: binary restarts
for spec in "M2.5a|$CH|$CHRS|serial" "M2.5b|$CHPAR|$CHPARRS|4 ranks (4 1 1)"
do
  IFS='|' read -r id cont rest text <<< "$spec"
  out=$("$CMPFIELDS" -x uniform/time "$cont" "$rest" 0.2)
  status=$?
  echo "$out" | head -10
  if [ $status -eq 0 ] && grep -q '^End' "$rest/log" \
    && grep -q 'Restart of pair PbI2_g: .* differs from the ledger by 0 kg' \
      "$rest/log"
  then
    result "$id" PASS "channel binary restart from 0.1, $text: ${out#IDENTICAL: }\
 at 0.2 (fields, mw_, and in uniform/ the ledger, its layout, the deposits\
 and the regimes); restart term 0"
  else
    result "$id" FAIL "channel binary restart from 0.1, $text: differs at 0.2\
 or failed ($rest/log)"
  fi
done

# M2.5c: ascii restart without writePrecision
if grep -q '^End' "$CHASCRS/log"
then
  restartLine=$(grep 'Restart of pair PbI2_g' "$CHASCRS/log")
  datRestart=$CHASCRS/postProcessing/phaseChangeBalance/0.1/PbI2_g.dat
  term=$($CHECKS nonzero "$datRestart" restart)
  closure=$($CHECKS closure "$datRestart" 1e-13)
  status=$?
  check M2.5c "channel ascii restart (writePrecision 6) from 0.1:\
 '${restartLine#*: }'; ${term#*: }; ${closure#*: }" \
    eval '[ $status -eq 0 ] && [[ "$term" == OK* ]] \
      && [[ "$restartLine" == *"gas: Y_PbI2_g written in ascii; deposits: uniform/phaseChange/phaseChangeDeposits; rounded)"* ]]'
else
  result M2.5c FAIL "ascii restart failed ($CHASCRS/log)"
fi

# M2.5d: state fields without the ledger
CHNOLEDGER=$PC_DIR/channelNoLedger
restartCopy "$CH" "$CHNOLEDGER" 0.1
rm -f "$CHNOLEDGER/0.1/uniform/phaseChangeBalance"
expectFatal M2.5d "restart directory with mw_PbI2_s but without\
 uniform/phaseChangeBalance" "$CHNOLEDGER" \
  "but not the ledger uniform/phaseChangeBalance"

# M2.5e: binary restart whose deposits belong to another time
CHFOREIGN=$PC_DIR/channelForeignState
restartCopy "$CH" "$CHFOREIGN" 0.1
cp "$CH/0.15/uniform/phaseChange/phaseChangeDeposits" \
  "$CHFOREIGN/0.1/uniform/phaseChange/phaseChangeDeposits"
expectFatal M2.5e "binary restart with the deposits\
 (uniform/phaseChange/phaseChangeDeposits) of 0.15 in 0.1" "$CHFOREIGN"\
 "more than the round-off bound 1e-14"

# M2.5r: a ledger layout with the transport patches in another order
restartCopy "$CH" "$CHLAYOUT" 0.1
edit "$CHLAYOUT/0.1/uniform/phaseChangeLayout" \
  's/^(transportPatches +3 +\( +)INLET OUTLET (WALL +\);)/\1OUTLET INLET \2/' \
  'OUTLET INLET WALL' || exit 1
expectFatal M2.5r "ledger layout with the transport patches (OUTLET INLET\
 WALL) instead of (INLET OUTLET WALL)" "$CHLAYOUT"\
 "Its entries are addressed by position"

# M2.5f: B5, the regimes decide the first corrector of a converging loop
if grep -q '^End' "$CHCONVRS/log" && grep -q '^End' "$CHCONVNOREG/log"
then
  with=$("$CMPFIELDS" -x uniform/time "$CHCONV" "$CHCONVRS" 0.2)
  s1=$?
  without=$("$CMPFIELDS" -x uniform/time "$CHCONV" "$CHCONVNOREG" 0.2)
  s2=$?
  nDiffer=$(echo "$without" | grep -c '^Differs')
  check M2.5f "converging channel restarted from 0.1: with\
 uniform/phaseChange/phaseChangeRegimes ${with#IDENTICAL: } identical at 0.2; without\
 it the warning and $nDiffer files differ" \
    eval '[ $s1 -eq 0 ] && [ $s2 -ne 0 ] && [ $nDiffer -ge 1 ] \
      && grep -q "uniform/phaseChange/phaseChangeRegimes at time 0.1 is missing" "$CHCONVNOREG/log" \
      && ! grep -q "uniform/phaseChange/phaseChangeRegimes at time" "$CHCONVRS/log"'
else
  result M2.5f FAIL "converging channel restarts failed ($CHCONVRS/log)"
fi

# M2.5g: restart at a rounded time name
if [ -n "$restartTime3" ] && grep -q '^End' "$CLOCK3RS/log" \
  && grep -q '^End' "$CLOCK3/log"
then
  rows=$($CHECKS sameRows "$(balanceFile "$CLOCK3")" \
    "$CLOCK3RS/postProcessing/phaseChangeBalance/$restartTime3/PbI2_g.dat")
  status=$?
  warning=$(grep -A2 'The start time .* differs from the time' "$CLOCK3RS/log" \
    | grep -o 'The start time .* deltaT)')
  check M2.5g "restart from the rounded time name $restartTime3: '$warning';\
 ${rows#*: }" \
    eval '[ $status -eq 0 ] && [ -n "$warning" ]'
else
  result M2.5g FAIL "channel with timePrecision 3 or its restart failed\
 ($CLOCK3/log, $CLOCK3RS/log)"
fi

# M2.5k: regimes of other elements after a re-decomposition
if grep -q '^End' "$CHREV/log" 2>/dev/null
then
  restartLine=$(grep 'Restart of pair PbI2_g' "$CHREV/log")
  check M2.5k "4-rank channel re-decomposed with reversed slabs (processor\
 patches per rank: $(processorPatches "$CHREV")): regimes and deposits of\
 the other elements not used (warnings); '${restartLine#*: }'" \
    eval 'grep -q "uniform/phaseChange/phaseChangeRegimes at time 0.1 is missing or belongs to other interface elements" "$CHREV/log" \
      && grep -q "uniform/phaseChange/phaseChangeDeposits at time 0.1 is written for other interface elements" "$CHREV/log" \
      && echo "$restartLine" | grep -q "deposits: mw_PbI2_s written in binary; exact)"'
else
  result M2.5k FAIL "re-decomposed channel restart failed ($CHREV/log)"
fi

# M2.4d: closure of the 4-rank channels, whose decomposed carrier holds
# uniform processor-patch values written with about 10 digits
if grep -q '^End' "$CHPAR/log" && grep -q '^End' "$CHCOLL/log"
then
  uniformValue=$(grep -a -A3 'procBoundary0to1' "$CHPAR/processor0/0/rho" \
    | grep -a -o 'value *uniform [0-9.e+-]*' | tr -s ' ')
  closure=$($CHECKS closure "$CHPAR/$BALANCE" 1e-13)
  s1=$?
  collated=$($CHECKS closure "$CHCOLL/$BALANCE" 1e-13)
  s2=$?
  check M2.4d "channel on 4 ranks, simple (4 1 1), decomposed carrier with\
 '$uniformValue' on procBoundary0to1 of rho: ${closure#*: }; collated\
 ${collated#*: }" \
    eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ -n "$uniformValue" ]'
else
  result M2.4d FAIL "4-rank channels failed ($CHPAR/log, $CHCOLL/log)"
fi

# M2.4f: serial vs 4 ranks with an outer loop that exits unconverged
if grep -q '^End' "$CHPAR/log" && grep -q '^End' "$CH/log"
then
  out=$($CHECKS compare "$CH/$BALANCE" "$CHPAR/$BALANCE" 1e-5 gas wall)
  status=$?
  nUnconverged=$(grep -c 'exchange: .*, NOT converged (' "$CHPAR/log")
  residual=$(grep -m1 -o 'NOT converged (initial residual [^,]*' "$CHPAR/log" \
    | sed 's/.*residual //')
  check M2.4f "channel with its own outer loop (nCorr 3, tolerance 1e-7:\
 $nUnconverged of 200 steps exit unconverged, e.g. at the initial residual\
 $residual), 4 ranks simple (4 1 1) vs serial: ${out#*: }; 1e-9 needs a\
 converged outer loop (M2.4a-c, M2.4e)" [ $status -eq 0 ]
else
  result M2.4f FAIL "channel runs failed ($CH/log, $CHPAR/log)"
fi

# M2.4g: processor patches of mw_ evaluated before the write
if grep -q '^End' "$CHPAR/log"
then
  out=$($CHECKS processorPatches "$CHPAR" 0.2 mw_PbI2_s)
  check M2.4g "4-rank channel, processor patches of ${out#*: }" [ $? -eq 0 ]
else
  result M2.4g FAIL "4-rank channel failed ($CHPAR/log)"
fi

# M2.5l: collated, binary
if grep -q '^End' "$CHCOLL/log" && grep -q '^End' "$CHCOLLRS/log" \
  && grep -q '^End' "$CHCOLLRSNOFMT/log"
then
  header=$(grep -a -m1 -o 'data.format *[a-z]*' \
    "$CHCOLL/processors4/0.1/Y_PbI2_g" | tr -s ' ')
  with=$("$CMPFIELDS" -x uniform/time "$CHCOLL" "$CHCOLLRS" 0.2)
  s1=$?
  without=$("$CMPFIELDS" -x uniform/time "$CHCOLL" "$CHCOLLRSNOFMT" 0.2)
  s2=$?
  check M2.5l "collated, binary ('$header'), restart from 0.1 on 4 ranks:\
 restart term 0, Y_PbI2_g written in binary; ${with#IDENTICAL: } at 0.2\
 cmp-identical; without data.format ${without#IDENTICAL: } identical" \
    eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ "$header" = "data.format binary" ] \
      && grep -q "Restart of pair PbI2_g: .* differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; exact)" "$CHCOLLRS/log" \
      && grep -q "Restart of pair PbI2_g: .* differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; exact)" "$CHCOLLRSNOFMT/log" \
      && ! grep -a -q "data.format" "$CHCOLLRSNOFMT/processors4/0.1/Y_PbI2_g"'
else
  result M2.5l FAIL "collated binary channel or its restarts failed\
 ($CHCOLL/log, $CHCOLLRS/log, $CHCOLLRSNOFMT/log)"
fi

# M2.5m: collated, ascii
if grep -q '^End' "$CHCOLLASCRS/log" && grep -q '^End' "$CHCOLLASCRSNOFMT/log"
then
  header=$(grep -a -E -o '^ *(format|data\.format) +[a-z]+;' \
    "$CHCOLLASC/processors4/0.1/Y_PbI2_g" | head -2 | tr -s ' ' \
    | tr '\n' ' ')
  restartLine=$(grep 'Restart of pair PbI2_g' "$CHCOLLASCRS/log")
  dat=$CHCOLLASCRS/postProcessing/phaseChangeBalance/0.1/PbI2_g.dat
  term=$($CHECKS nonzero "$dat" restart)
  closure=$($CHECKS closure "$dat" 1e-13)
  status=$?
  closureNoFmt=$($CHECKS closure \
    "$CHCOLLASCRSNOFMT/postProcessing/phaseChangeBalance/0.1/PbI2_g.dat" 1e-13)
  s2=$?
  check M2.5m "collated, ascii (header '$header'), restart from 0.1 on 4\
 ranks: '${restartLine#*: }'; ${term#*: }; ${closure#*: }; without\
 data.format also 'Y_PbI2_g written in ascii', ${closureNoFmt#*: }" \
    eval '[ $status -eq 0 ] && [ $s2 -eq 0 ] && [[ "$term" == OK* ]] \
      && [[ "$restartLine" == *"gas: Y_PbI2_g written in ascii; deposits: uniform/phaseChange/phaseChangeDeposits; rounded)"* ]] \
      && grep -q "gas: Y_PbI2_g written in ascii; deposits: uniform/phaseChange/phaseChangeDeposits; rounded), booked as restart" "$CHCOLLASCRSNOFMT/log"'
else
  result M2.5m FAIL "collated ascii restarts failed ($CHCOLLASCRS/log,\
 $CHCOLLASCRSNOFMT/log)"
fi

# uniformEntry <file> <patch>: the value of a 'uniform' value entry of the
# patch (nothing for a nonuniform list), from a binary or ascii field file
uniformEntry() {
  grep -a -A4 -E "^ *$2\$" "$1" | grep -a -o -E 'value +uniform +[^;]+' \
    | head -1 | awk '{print $3}'
}

# M2.5n: mw_ of another time, deposits of uniform/ intact
if grep -q '^End' "$CHFOREIGNMW/log"
then
  out=$("$CMPFIELDS" -x uniform/time "$CH" "$CHFOREIGNMW" 0.2)
  status=$?
  check M2.5n "binary restart from 0.1 with mw_PbI2_s of 0.15: warning\
 'mw_PbI2_s at time 0.1 differs from the element deposits of\
 uniform/phaseChange/phaseChangeDeposits'; ${out#IDENTICAL: } at 0.2 cmp-identical to\
 the continuous run" \
    eval '[ $status -eq 0 ] \
      && grep -q "mw_PbI2_s at time 0.1 differs from the element deposits of uniform/phaseChange/phaseChangeDeposits" "$CHFOREIGNMW/log" \
      && grep -q "differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; exact)" "$CHFOREIGNMW/log"'
else
  result M2.5n FAIL "restart with a foreign mw_PbI2_s failed\
 ($CHFOREIGNMW/log)"
fi

# M2.5o: a rank with a single WALL face and a single processor face
if grep -q '^End' "$CHONE/log" && grep -q '^End' "$CHONERS/log"
then
  wallValue=$(uniformEntry "$CHONE/processor1/0.2/mw_PbI2_s" WALL)
  procValue=$(uniformEntry "$CHONE/processor1/0.2/Y_PbI2_g" procBoundary1to2)
  restartLine=$(grep 'Restart of pair PbI2_g' "$CHONERS/log")
  out=$("$CMPFIELDS" -x uniform/time "$CHONE" "$CHONERS" 0.3)
  status=$?
  check M2.5o "3 ranks, manual (processor patches per rank:\
 $(processorPatches "$CHONE"); WALL faces of rank 1:\
 $(grep -A3 -E '^ *WALL$' "$CHONE/processor1/constant/polyMesh/boundary" \
   | grep -o -E 'nFaces +[0-9]+' | awk '{print $2}')): at 0.2 the binary\
 files hold 'WALL ... value uniform $wallValue' (mw_PbI2_s) and\
 'procBoundary1to2 ... value uniform $procValue' (Y_PbI2_g); restart:\
 '${restartLine#*: }'; ${out#IDENTICAL: } at 0.3 cmp-identical" \
    eval '[ $status -eq 0 ] \
      && python3 -c "import sys; sys.exit(0 if float(\"$wallValue\") != 0 and float(\"$procValue\") != 0 else 1)" \
      && echo "$restartLine" | grep -q "differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; exact)"'
else
  result M2.5o FAIL "channel with a single WALL face on a rank or its\
 restart failed ($CHONE/log, $CHONERS/log)"
fi

# M2.5p: writes started by runTimeControl between two steps
rtcOk=true
rtcText=""
if ! grep -q '^End' "$CHRTC/log" \
  || ! grep -q 'Writing fields - step 1' "$CHRTC/log" \
  || ! grep -q 'Writing fields - final step' "$CHRTC/log"
then
  rtcOk=false
  rtcText=" the runTimeControl run failed ($CHRTC/log)"
fi
for spec in "0.056|$CHRTCRS1|writeNow" "0.057|$CHRTCRS2|writeAndEnd"
do
  IFS='|' read -r t c how <<< "$spec"
  stored=$(cd "$CHRTC/$t/uniform" 2>/dev/null && find . -type f \
    -name 'phaseChange*' | sed 's|^\./||' | LC_ALL=C sort | tr '\n' ' ')
  out=$("$CMPFIELDS" -x uniform/time \
    -x uniform/functionObjects/functionObjectProperties "$CH" "$c" 0.2)
  if [ $? -eq 0 ] && [ "$stored" = "phaseChange/phaseChangeDeposits\
 phaseChange/phaseChangeRegimes phaseChangeBalance phaseChangeLayout " ] \
    && grep -q '^End' "$c/log" \
    && grep -q "differs from the ledger by 0 kg" "$c/log"
  then
    rtcText="$rtcText $t ($how): uniform/ holds $stored, restart\
 ${out#IDENTICAL: } at 0.2 cmp-identical;"
  else
    echo "$out" | head -10
    rtcOk=false
    rtcText="$rtcText $t ($how): uniform/ holds '$stored', restart differs\
 or failed ($c/log);"
  fi
done
check M2.5p "channel written by runTimeControl between two steps\
 (uniform/time and functionObjectProperties excepted):$rtcText" $rtcOk

# M2.5q: no uniform/phaseChange/phaseChangeDeposits: the deposits from mw_
if grep -q '^End' "$CHNODEP/log"
then
  restartLine=$(grep 'Restart of pair PbI2_g' "$CHNODEP/log")
  out=$("$CMPFIELDS" -x uniform/time "$CH" "$CHNODEP" 0.2)
  status=$?
  check M2.5q "restart from 0.1 without uniform/phaseChange/phaseChangeDeposits:\
 warning 'is missing', '${restartLine#*: }'; ${out#IDENTICAL: } at 0.2\
 cmp-identical" \
    eval '[ $status -eq 0 ] \
      && grep -q "uniform/phaseChange/phaseChangeDeposits at time 0.1 is missing.  The deposits are re-read from the interface patches of 1(mw_PbI2_s)" "$CHNODEP/log" \
      && echo "$restartLine" | grep -q "differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: mw_PbI2_s written in binary; exact)"'
else
  result M2.5q FAIL "restart without uniform/phaseChange/phaseChangeDeposits failed\
 ($CHNODEP/log)"
fi

# M2.5s: writeFrozenFields yes, the carrier re-read at the restart
if grep -q '^End' "$BOXFROZENRS/log" 2>/dev/null \
  && grep -q '^End' "$CHFROZENRS/log"
then
  uniformRho=$(grep -a -o -E 'internalField +uniform [0-9.e+-]+' \
    "$BOXFROZEN/0.02/rho" | tr -s ' ')
  boxLine=$(grep 'Restart of pair PbI2_g' "$BOXFROZENRS/log")
  dat=$BOXFROZENRS/postProcessing/phaseChangeBalance/0.02/PbI2_g.dat
  term=$($CHECKS nonzero "$dat" restart)
  s1=$?
  closure=$($CHECKS closure "$dat" 1e-15)
  s2=$?
  channelLine=$(grep 'Restart of pair PbI2_g' "$CHFROZENRS/log")
  out=$("$CMPFIELDS" -x uniform/time "$CHFROZEN" "$CHFROZENRS" 0.2)
  s3=$?
  check M2.5s "binary restarts with writeFrozenFields yes: box ('$uniformRho'\
 in 0.02/rho): '${boxLine#*: }'; ${term#*: }; ${closure#*: }; channel:\
 '${channelLine#*: }', ${out#IDENTICAL: } at 0.2 cmp-identical" \
    eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $s3 -eq 0 ] \
      && [ "$uniformRho" = "internalField uniform 0.0975561" ] \
      && [[ "$boxLine" == *"gas: Y_PbI2_g written in binary; carrier: rho written in binary, a '"'"'uniform'"'"' value on some rank (text at writePrecision); deposits: uniform/phaseChange/phaseChangeDeposits; rounded for the next steps: rho ('"'"'uniform'"'"' on INLET OUTLET WALL TOP); rounded)"* ]] \
      && [[ "$channelLine" == *"differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; carrier: rho written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; exact)"* ]]'
else
  result M2.5s FAIL "restarts with writeFrozenFields yes failed\
 ($BOXFROZENRS/log, $CHFROZENRS/log)"
fi

# M2.5t: a restart with another interface
restartCopy "$CH" "$CHIFMULT" 0.1
edit "$CHIFMULT/constant/thermochemistryProperties" \
  's/^(  patches \(WALL\);)$/\1\n  areaMultiplier 2;/' 'areaMultiplier 2;' \
  && expectFatal M2.5t "binary restart of the channel from 0.1 with\
 areaMultiplier 2" "$CHIFMULT" "    areaMultiplier 2 (written with 1)"
restartCopy "$CHASC" "$CHIFAPV" 0.1
setControl "$CHIFAPV" endTime 0.2
edit "$CHIFAPV/constant/thermochemistryProperties" \
  's/^(  patches \(WALL\);)$/\1\n  areaPerVolume layer;/' \
  'areaPerVolume layer;' \
  && expectFatal M2.5t "ascii restart of the channel from 0.1 with\
 areaPerVolume layer" "$CHIFAPV" "    areaPerVolume layer (written with cell)"

# M2.5u: a restart that changes a release that has begun
restartCopy "$CHMID" "$CHSAMOUNT" 0.02
setControl "$CHSAMOUNT" endTime 0.2
edit "$CHSAMOUNT/constant/thermochemistryProperties" \
  's/^(    amount +)4.84e-6;/\15e-6;/' 'amount +5e-6;' \
  && expectFatal M2.5u "restart at 0.02, inside the release window, with the\
 amount changed" "$CHSAMOUNT" "    amount 5e-06 (written with 4.84e-06)"
restartCopy "$CHMID" "$CHSGONE" 0.02
setControl "$CHSGONE" endTime 0.2
removeSamples "$CHSGONE/constant/thermochemistryProperties" \
  && expectFatal M2.5u "restart at 0.02, inside the release window, with the\
 sample removed" "$CHSGONE" "has not ended at the restart (t = 0.02 s)"
restartCopy "$CH" "$CHSNEW" 0.1
addSample "$CHSNEW/constant/thermochemistryProperties" 0.05 \
  && expectFatal M2.5u "restart at 0.1 with a new sample whose window\
 [0.05, 0.07] s began before" "$CHSNEW" "is new at the restart from time 0.1"

# M2.5v: accepted changes of the schedule
if grep -q '^End' "$CHSDONE/log" && grep -q '^End' "$CHSLATE/log"
then
  out=$("$CMPFIELDS" -x uniform/time -x uniform/phaseChangeLayout "$CH" \
    "$CHSDONE" 0.2)
  s1=$?
  dat=$CHSLATE/postProcessing/phaseChangeBalance/0.1/PbI2_g.dat
  released=$($CHECKS released "$dat" 5.84e-6 $MPBI2 1e-14)
  s2=$?
  closure=$($CHECKS closure "$dat" 1e-13)
  s3=$?
  check M2.5v "restart from 0.1 with the sample removed after its window:\
 ${out#IDENTICAL: } at 0.2 cmp-identical (but the layout); with a new\
 sample from 0.15 s: ${released#*: }; ${closure#*: }" \
    eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $s3 -eq 0 ]'
else
  result M2.5v FAIL "restarts with accepted schedule changes failed\
 ($CHSDONE/log, $CHSLATE/log)"
fi

# M2.5w: a layout of an earlier build
if grep -q '^End' "$CHOLDLAYOUT/log"
then
  out=$("$CMPFIELDS" -x uniform/time "$CH" "$CHOLDLAYOUT" 0.2)
  status=$?
  check M2.5w "restart from 0.1 with a layout without the interface, the\
 samples and the uniform values (earlier build): two warnings;\
 ${out#IDENTICAL: } at 0.2 cmp-identical" \
    eval '[ $status -eq 0 ] \
      && grep -q "does not record the interface (written by an earlier build" "$CHOLDLAYOUT/log" \
      && grep -q "does not record the release samples (written by an earlier build" "$CHOLDLAYOUT/log"'
else
  result M2.5w FAIL "restart with an earlier layout failed ($CHOLDLAYOUT/log)"
fi

# M2.5x: rounded boundary values of the gas
if grep -q '^End' "$CHINLETY/log" && grep -q '^End' "$CHINLETYRS/log"
then
  inlet=$(uniformEntry "$CHINLETY/0.05/Y_PbI2_g" INLET)
  restartLine=$(grep 'Restart of pair PbI2_g' "$CHINLETYRS/log")
  out=$("$CMPFIELDS" -x uniform/time "$CHINLETY" "$CHINLETYRS" 0.1)
  status=$?
  check M2.5x "inlet-fed channel, Y_PbI2_g 1.234567891e-3 at the INLET\
 (written as 'uniform $inlet'), binary restart from 0.05:\
 '${restartLine#*: }'; the files at 0.1 differ from the continuous run\
 ($(echo "$out" | grep -c '^Differs') differ), as stated" \
    eval '[ $status -ne 0 ] && [ "$inlet" = "0.00123457" ] \
      && echo "$restartLine" | grep -q "differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; rounded for the next steps: Y_PbI2_g ('"'"'uniform'"'"' on INLET); inventory exact, continuation rounded)" \
      && echo "$out" | grep -q "^Differs: 0.1/Y_PbI2_g"'
else
  result M2.5x FAIL "inlet-fed channel with a rounded inlet value or its\
 restart failed ($CHINLETY/log, $CHINLETYRS/log)"
fi
if grep -q '^End' "$CHINLETRS/log" && grep -q '^End' "$CHINLETRSNOREC/log"
then
  line1=$(grep 'Restart of pair PbI2_g' "$CHINLETRS/log")
  line2=$(grep 'Restart of pair PbI2_g' "$CHINLETRSNOREC/log")
  check M2.5x "inlet-fed channel, Y_PbI2_g 1e-3 at the INLET, restart from\
 0.05: '${line1#*: }'; without the record uniformValues in\
 uniform/phaseChangeLayout (earlier build): '${line2#*: }'" \
    eval 'echo "$line1" | grep -q "differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; exact)" \
      && echo "$line2" | grep -q "differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; possibly rounded for the next steps: Y_PbI2_g ('"'"'uniform'"'"' on INLET); inventory exact, continuation rounded)"'
else
  result M2.5x FAIL "restarts of the inlet-fed channel failed\
 ($CHINLETRS/log, $CHINLETRSNOREC/log)"
fi

# M2.5y: rounded boundary values of the carrier (writeFrozenFields yes)
if grep -q '^End' "$CHFROZEN12/log" && grep -q '^End' "$CHFROZEN12RS/log"
then
  rho0=$(uniformEntry "$CHFROZEN12/0/rho" INLET)
  rho5=$(uniformEntry "$CHFROZEN12/0.05/rho" INLET)
  restartLine=$(grep 'Restart of pair PbI2_g' "$CHFROZEN12RS/log")
  out=$("$CMPFIELDS" -x uniform/time "$CHFROZEN12" "$CHFROZEN12RS" 0.1)
  status=$?
  check M2.5y "writeFrozenFields yes, carrier written at 12 digits (0/rho\
 INLET 'uniform $rho0', 0.05/rho INLET 'uniform $rho5'), inlet-fed,\
 restart from 0.05: '${restartLine#*: }'; the files at 0.1 differ from the\
 continuous run ($(echo "$out" | grep -c '^Differs') differ), as stated" \
    eval '[ $status -ne 0 ] && [ "$rho5" = "0.0487781" ] \
      && [ "$rho0" = "0.0487780706503" ] \
      && echo "$restartLine" | grep -q "differs from the ledger by 0 kg (relative 0; gas: Y_PbI2_g written in binary; carrier: rho written in binary; deposits: uniform/phaseChange/phaseChangeDeposits; rounded for the next steps: rho ('"'"'uniform'"'"' on INLET); inventory exact, continuation rounded)" \
      && echo "$out" | grep -q "^Differs: 0.1/Y_PbI2_g"'
else
  result M2.5y FAIL "channel with the 12-digit carrier or its restart failed\
 ($CHFROZEN12/log, $CHFROZEN12RS/log)"
fi

# M2.4h: halfCell on 4 ranks, ranks without WALL faces
faces=$(wallFaces "$CHHALF")
if [ $halfStatus -eq 0 ] && grep -q '^End' "$CHHALF/log"
then
  closure=$($CHECKS closure "$CHHALF/$BALANCE" 1e-13)
  check M2.4h "channel, wallResistance halfCell, 4 ranks simple (1 4 1)\
 (WALL faces per rank: $faces): ends; ${closure#*: }" \
    eval '[[ "$closure" == OK* ]] && [[ " $faces" == *" 0 "* ]]'
else
  result M2.4h FAIL "channel, wallResistance halfCell, 4 ranks simple\
 (1 4 1) (WALL faces per rank: $faces): exit status $halfStatus (124: hung,\
 stopped after MPI_TIMEOUT = 300 s; $CHHALF/log)"
fi


#------------------------------------------------------------------------------
# M2.6: start-up checks (closed box and channel variants)
#------------------------------------------------------------------------------
fatalCase() {
  blockCase closedBox "$PC_DIR/fatal-$1" > /dev/null && echo "$PC_DIR/fatal-$1"
}

c=$(fatalCase backward) && edit "$c/system/fvSchemes" \
  's/default Euler;/default backward;/' 'backward' \
  && expectFatal M2.6a "backward ddt" "$c" \
       "needs the Euler ddtScheme for ddt(rho,Y_PbI2_g), not backward"

c=$(fatalCase fixedValueWall) && edit "$c/0/Y_PbI2_g" \
  's/^  "\(INLET\|OUTLET\|WALL\|TOP\)" \{type zeroGradient;\}$/  "(INLET|OUTLET|TOP)" {type zeroGradient;}\n  WALL {type fixedValue; value uniform 0;}/' \
  'WALL \{type fixedValue' \
  && expectFatal M2.6b "fixedValue WALL for Y_PbI2_g" "$c" \
       "needs zeroGradient on the interface patch WALL, not fixedValue"

c=$(fatalCase relTol) && edit "$c/system/fvSolution" \
  's/tolerance 1e-15; relTol 0;/tolerance 1e-15; relTol 0.1;/' 'relTol 0.1' \
  && expectFatal M2.6c "final solve Y_PbI2_g with relTol 0.1 (no Final\
 dictionary)" "$c" "paired species Y_PbI2_g uses Y_PbI2_g with relTol"

c=$(fatalCase relTolFinal) && edit "$c/system/fvSolution" \
  's/^(  Y_PbI2_s .*)$/  Y_PbI2_gFinal {solver PBiCGStab; preconditioner DILU; tolerance 1e-15; relTol 0.05;}\n\1/' \
  'Y_PbI2_gFinal' \
  && expectFatal M2.6c "final solve Y_PbI2_gFinal with relTol 0.05" "$c" \
       "paired species Y_PbI2_g uses Y_PbI2_gFinal with relTol"

# sampleIn <case> <box> <mode>: add a sample selected by a box
sampleIn() {
  cat >> "$1/constant/thermochemistryProperties" <<EOF

samples {
  boat {
    pair      PbI2_g;
    selection { boat { action use; source box; box $2; } }
    mode      $3;
    amount    1e-9;
    duration  0.01;
  }
}
EOF
}

c=$(fatalCase sampleInLayer) \
  && sampleIn "$c" "(0.002 -1 -1) (0.004 1 1)" release \
  && expectFatal M2.6d "sample overlapping the interaction layer" "$c" \
       "cells lie in the interaction layer"

c=$(fatalCase molarMass) && edit "$c/constant/speciesTransportProperties" \
  's/ molarMass 0.46100894;//' 'D 1e-4;\}' \
  && expectFatal M2.6e "pair PbI2_g without molarMass" "$c" \
       "the gas species PbI2_g needs molarMass [kg/mol]"

notYet=true
c=$(fatalCase hks) && edit "$c/constant/thermochemistryProperties" \
  's/^model temperature;/model HKS;/' '^model HKS;' || notYet=false
if runSerial "$c" "$SOLVER_EXE" \
  || ! grep -q "Pair PbI2_g: model HKS needs vapourPressure" "$c/log"
then
  notYet=false
fi
c=$(fatalCase distance) && edit "$c/constant/thermochemistryProperties" \
  's/^(  layer +)faceCells;/\1distance;\n  distance 1e-4;/; s/^(  areaPerVolume +)cell;/\1layer;/' \
  'areaPerVolume +layer;' \
  || notYet=false
if ! runSerial "$c" "$SOLVER_EXE" \
  || ! grep -q '^Interface (layer distance): patches (WALL), distance 0.0001 m: 10 elements in 10 cells;' "$c/log"
then
  notYet=false
fi
c=$(fatalCase distanceNoEntry) \
  && edit "$c/constant/thermochemistryProperties" \
       's/^(  layer +)faceCells;/\1distance;/' 'layer +distance;' \
  || notYet=false
if runSerial "$c" "$SOLVER_EXE" || ! grep -q "Entry 'distance' not found" "$c/log"
then
  notYet=false
fi
c=$(fatalCase inventory) \
  && sampleIn "$c" "(0.002 -1 -1) (0.004 1 1)" inventory || notYet=false
if runSerial "$c" "$SOLVER_EXE" \
  || ! grep -q "Sample boat: mode inventory needs model HKS" "$c/log"
then
  notYet=false
fi
check M2.6f "the former 'not yet implemented' stops: since M4 layer distance\
 runs (the closed box, distance 1e-4: its 10 cells) and stops without a\
 distance entry; since M5 model HKS without a vapourPressure table and mode\
 inventory with model temperature stop with their own messages" $notYet

# M2.6g: fresh start after the release window has begun
CHLATE=$PC_DIR/fatal-lateFreshStart
blockCase channel "$CHLATE" && mv "$CHLATE/0" "$CHLATE/0.02" \
  && expectFatal M2.6g "fresh start at 0.02 s of the channel whose release\
 window begins at 0.3 ms" "$CHLATE" "of its amount (2.35427e-06 mol) would\
 never be released"

# M2.6h: fvSolution modified during the run
BOXMOD=$PC_DIR/fatal-fvSolutionModified
blockCase closedBox "$BOXMOD" \
  && setControl "$BOXMOD" runTimeModifiable true \
  && cat >> "$BOXMOD/system/controlDict" <<'EOF'

OptimisationSwitches { fileModificationSkew 0; }

functions {
  loosenFinalSolve {
    type            systemCall;
    libs            (utilityFunctionObjects);
    executeControl  timeStep;
    executeInterval 1;
    writeControl    none;
    timeStart       0.011;
    timeEnd         0.013;
    executeCalls    ("sleep 1; sed -i 's/relTol 0;/relTol 0.1;/' system/fvSolution");
    writeCalls      ();
    endCalls        ();
  }
}
EOF
if runSerial "$BOXMOD" "$SOLVER_EXE"
then
  result M2.6h FAIL "fvSolution modified during the run: the run did not\
 stop ($BOXMOD/log)"
else
  lastTime=$(grep '^Time = ' "$BOXMOD/log" | tail -1)
  check M2.6h "fvSolution changed to relTol 0.1 at 12 ms during the run: stops\
 at '$lastTime' with '(fvSolution was modified during the run)'" \
    eval 'grep -q "uses Y_PbI2_g with relTol 0.1.*it needs relTol 0 (fvSolution was modified during the run)" "$BOXMOD/log" \
      && grep -q "^Time = 0.016" "$BOXMOD/log"'
fi

# the same with the ddt scheme: fvSchemes changed to backward at 12 ms
BOXDDT=$PC_DIR/fatal-fvSchemesModified
blockCase closedBox "$BOXDDT" \
  && setControl "$BOXDDT" runTimeModifiable true \
  && cat >> "$BOXDDT/system/controlDict" <<'EOF'

OptimisationSwitches { fileModificationSkew 0; }

functions {
  backwardDdt {
    type            systemCall;
    libs            (utilityFunctionObjects);
    executeControl  timeStep;
    executeInterval 1;
    writeControl    none;
    timeStart       0.011;
    timeEnd         0.013;
    executeCalls    ("sleep 1; sed -i 's/default Euler;/default backward;/' system/fvSchemes");
    writeCalls      ();
    endCalls        ();
  }
}
EOF
if runSerial "$BOXDDT" "$SOLVER_EXE"
then
  result M2.6h FAIL "fvSchemes modified during the run: the run did not\
 stop ($BOXDDT/log)"
else
  lastTime=$(grep '^Time = ' "$BOXDDT/log" | tail -1)
  check M2.6h "fvSchemes changed to the ddt scheme backward at 12 ms during\
 the run ('Re-reading object fvSchemes'): stops at '$lastTime' with 'not\
 backward (fvSchemes was modified during the run)'" \
    eval 'grep -q "needs the Euler ddtScheme for ddt(rho,Y_PbI2_g), not backward (fvSchemes was modified during the run)" "$BOXDDT/log" \
      && grep -q "Re-reading object fvSchemes" "$BOXDDT/log" \
      && grep -q "^Time = 0.016" "$BOXDDT/log"'
fi


# M2.6j: solvers given by patterns (the boxes ran with the other boxes)
if grep -q '^End' "$BOXPATTERN/log" && grep -q '^End' "$BOXPATTERNFINAL/log"
then
  line1=$(grep -o 'final solve with .*' "$BOXPATTERN/log")
  line2=$(grep -o 'final solve with .*' "$BOXPATTERNFINAL/log")
  nFinal1=$(grep -c 'exchange: .*; final predictor' "$BOXPATTERN/log")
  nFinal2=$(grep -c 'exchange: .*; final predictor' "$BOXPATTERNFINAL/log")
  form1=$($CHECKS closedForm "$BOXPATTERN" 1e-3 "$LDT" 1e-14)
  s1=$?
  form2=$($CHECKS closedForm "$BOXPATTERNFINAL" 1e-3 "$LDT" 1e-14)
  s2=$?
  check M2.6j "solvers \"Y_.*\" alone: '$line1', $nFinal1 final predictors,\
 ${form1#*: }; \"Y_.*\" then \"Y_.*Final\": '$line2', $nFinal2 final\
 predictors, ${form2#*: }" \
    eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $nFinal1 -eq 0 ] \
      && [ $nFinal2 -eq 10 ] \
      && [ "$line1" = "final solve with Y_PbI2_g (relTol 0) (fvSolution entry \"Y_.*\")" ] \
      && [ "$line2" = "final solve with Y_PbI2_gFinal (fvSolution entry \"Y_.*Final\")" ]'
else
  result M2.6j FAIL "boxes with solver patterns did not run\
 ($BOXPATTERN/log, $BOXPATTERNFINAL/log)"
fi

c=$(fatalCase solverPatternShadowed) && edit "$c/system/fvSolution" \
  's/^  Y_PbI2_g \{(.*)relTol 0;\}$/  "Y_.*Final" {\1relTol 0;}\n  "Y_.*" {\1relTol 0.1;}/' \
  '^  "Y_\.\*" \{' \
  && expectFatal M2.6j "solvers \"Y_.*Final\" (relTol 0) before \"Y_.*\"\
 (relTol 0.1): the Final pattern is shadowed" "$c" \
       'Y_PbI2_gFinal selects the solvers entry "Y_.*", as Y_PbI2_g does'

# M2.6k: a non-conservative convection scheme, at start-up and at a step
c=$(fatalCase boundedGauss) && edit "$c/system/fvSchemes" \
  's/div\(phi,Y_PbI2_g\) Gauss upwind;/div(phi,Y_PbI2_g) bounded Gauss upwind;/' \
  'bounded Gauss upwind' \
  && expectFatal M2.6k "convection scheme 'bounded Gauss upwind'" "$c" \
       "needs a conservative convection scheme 'Gauss <interpolation>' for div(phi,Y_PbI2_g), not 'bounded Gauss upwind'."

BOXDIV=$PC_DIR/fatal-fvSchemesBounded
blockCase closedBox "$BOXDIV" \
  && setControl "$BOXDIV" runTimeModifiable true \
  && cat >> "$BOXDIV/system/controlDict" <<'EOF'

OptimisationSwitches { fileModificationSkew 0; }

functions {
  boundedConvection {
    type            systemCall;
    libs            (utilityFunctionObjects);
    executeControl  timeStep;
    executeInterval 1;
    writeControl    none;
    timeStart       0.011;
    timeEnd         0.013;
    executeCalls    ("sleep 1; sed -i 's/ Gauss upwind;/ bounded Gauss upwind;/' system/fvSchemes");
    writeCalls      ();
    endCalls        ();
  }
}
EOF
if runSerial "$BOXDIV" "$SOLVER_EXE"
then
  result M2.6k FAIL "fvSchemes modified during the run: the run did not\
 stop ($BOXDIV/log)"
else
  lastTime=$(grep '^Time = ' "$BOXDIV/log" | tail -1)
  check M2.6k "fvSchemes changed to 'bounded Gauss upwind' at 12 ms during\
 the run: stops at '$lastTime' with 'not 'bounded Gauss upwind' (fvSchemes\
 was modified during the run)'" \
    eval 'grep -q "for div(phi,Y_PbI2_g), not '"'"'bounded Gauss upwind'"'"' (fvSchemes was modified during the run)" "$BOXDIV/log" \
      && grep -q "Re-reading object fvSchemes" "$BOXDIV/log" \
      && grep -q "^Time = 0.016" "$BOXDIV/log"'
fi

# M2.6l: wallResistance halfCell with a scaled element area
c=$(fatalCase halfCellAreaMultiplier) \
  && edit "$c/constant/thermochemistryProperties" \
       's/^(  wallResistance +)none;/\1halfCell;/; s/^(  areaMultiplier +)1;/\12;/' \
       'areaMultiplier +2;' \
  && expectFatal M2.6l "wallResistance halfCell with areaMultiplier 2" "$c" \
       "wallResistance halfCell needs areaMultiplier 1 and areaPerVolume cell, not areaMultiplier 2 and areaPerVolume cell."
c=$(fatalCase halfCellAreaPerVolume) \
  && edit "$c/constant/thermochemistryProperties" \
       's/^(  wallResistance +)none;/\1halfCell;/; s/^(  areaPerVolume +)cell;/\1layer;/' \
       'areaPerVolume +layer;' \
  && expectFatal M2.6l "wallResistance halfCell with areaPerVolume layer" \
       "$c" "wallResistance halfCell needs areaMultiplier 1 and areaPerVolume cell, not areaMultiplier 1 and areaPerVolume layer."

# M2.6m: keys of mode inventory in a release sample (the channel's boat)
inventoryKeysOk=true
inventoryKeysText=""
for entry in "removeTime 0.02" "areaPerVolume 4000" "kineticScale 1" "Ce 1"
do
  key=${entry%% *}
  c=$PC_DIR/fatal-releaseSample-$key
  if blockCase channel "$c" > /dev/null \
    && edit "$c/constant/thermochemistryProperties" \
         "s/^(    duration +0.0405;)$/\\1\\n    $entry;/" "^    $entry;" \
    && ! runSerial "$c" "$SOLVER_EXE" \
    && grep -q "Sample boat: $key belongs to mode inventory, not to mode release; the sample would not use it." "$c/log"
  then
    inventoryKeysText="$inventoryKeysText $key"
  else
    inventoryKeysOk=false
    inventoryKeysText="$inventoryKeysText $key (not refused, $c/log)"
  fi
done
check M2.6m "release sample with a key of mode inventory: FatalIOError\
 'Sample boat: <key> belongs to mode inventory, not to mode release' (since\
 M5; before: 'which is not yet implemented') for$inventoryKeysText"\
 $inventoryKeysOk


#------------------------------------------------------------------------------
# M2.3 and M2.4: pipe on the 007 carrier, serial and 4 ranks
#------------------------------------------------------------------------------
PIPE=$PC_DIR/pipe

preparePipe() {
  makeCase 012 "$1" \
    && setControl "$1" endTime 0.1 \
    && setControl "$1" deltaT 0.004 \
    && setControl "$1" writeInterval 25 \
    && edit "$1/system/controlDict" \
         's/^(  tolerance +)[^; ]+;/\11e-9;/; s/^(  nCorr +)[0-9]+;/\120;/' \
         'nCorr +20;' \
    && edit "$1/0/Y_PbI2_g" 's/^(internalField +)uniform 0;/\1uniform 0.1;/' \
         'uniform 0.1;' \
    && edit "$1/constant/thermochemistryProperties" \
         's/^(  writeFile +yes;.*)$/\1\n  reportMatrixResidual yes;/' \
         'reportMatrixResidual yes'
}

preparePipe "$PIPE" || exit 1

# M2.4e: the same pipe with run/012's own outer loop (nCorr 10, tolerance
# 1e-5: converging), serial and 4 ranks simple (4 1 1) and hierarchical
# (2 2 1)
PIPE012=$PC_DIR/pipeOuter012
PIPE012PAR=$PC_DIR/pipeOuter012-simple411
PIPE012HIER=$PC_DIR/pipeOuter012-hierarchical221
for c in "$PIPE012" "$PIPE012PAR" "$PIPE012HIER"
do
  makeCase 012 "$c" \
    && setControl "$c" endTime 0.1 \
    && setControl "$c" deltaT 0.004 \
    && setControl "$c" writeInterval 25 \
    && edit "$c/0/Y_PbI2_g" 's/^(internalField +)uniform 0;/\1uniform 0.1;/' \
         'uniform 0.1;' \
    && grep -q -E '^  tolerance +1.0e-5;' "$c/system/controlDict" \
    && grep -q -E '^  nCorr +10;' "$c/system/controlDict" \
    || { echo "Setting up $c failed"; exit 1; }
done
decomposeWith "$PIPE012PAR" 4 "method simple; coeffs { n (4 1 1); }" \
  || { echo "decomposePar failed ($PIPE012PAR)"; exit 1; }
decomposeWith "$PIPE012HIER" 4 \
  "method hierarchical; coeffs { n (2 2 1); order xyz; }" \
  || { echo "decomposePar failed ($PIPE012HIER)"; exit 1; }

declare -A DECOMPOSITION=(
  [simple411]="method simple; coeffs { n (4 1 1); }"
  [simple221]="method simple; coeffs { n (2 2 1); }"
  [hierarchical221]="method hierarchical; coeffs { n (2 2 1); order xyz; }"
)
for d in simple411 simple221 hierarchical221
do
  preparePipe "$PC_DIR/pipe-$d" \
    && decomposeWith "$PC_DIR/pipe-$d" 4 "${DECOMPOSITION[$d]}" \
    || { echo "decomposePar failed ($PC_DIR/pipe-$d)"; exit 1; }
done

# M2.5j: 2 steps in serial, in binary, with the background gas everywhere
PIPERS=$PC_DIR/pipeRestart
PIPERD=$PC_DIR/pipeRestartRedecomposed
makeCase 012 "$PIPERS" \
  && setControl "$PIPERS" endTime 0.008 \
  && setControl "$PIPERS" deltaT 0.004 \
  && setControl "$PIPERS" writeInterval 2 \
  && edit "$PIPERS/0/Y_PbI2_g" 's/^(internalField +)uniform 0;/\1uniform 0.1;/' \
       'uniform 0.1;' \
  || exit 1

# (waits for these runs only, not for the M8-scale channel)
echo "Running the pipe: serial, simple (4 1 1) and the 2-step restart source"
runSerial "$PIPE" "$SOLVER_EXE" &
p1=$!
runParallel "$PC_DIR/pipe-simple411" "$SOLVER_EXE" 4 &
p2=$!
runSerial "$PIPERS" "$SOLVER_EXE" &
p3=$!
wait $p1 $p2 $p3
echo "Running the pipe: simple (2 2 1) and hierarchical (2 2 1)"
runParallel "$PC_DIR/pipe-simple221" "$SOLVER_EXE" 4 &
p1=$!
runParallel "$PC_DIR/pipe-hierarchical221" "$SOLVER_EXE" 4 &
p2=$!
wait $p1 $p2
echo "Running the pipe with run/012's outer loop: serial, simple (4 1 1)\
 and hierarchical (2 2 1)"
runSerial "$PIPE012" "$SOLVER_EXE" &
p1=$!
runParallel "$PIPE012PAR" "$SOLVER_EXE" 4 &
p2=$!
runParallel "$PIPE012HIER" "$SOLVER_EXE" 4 &
p3=$!
wait $p1 $p2 $p3

if grep -q '^End' "$PIPE/log"
then
  check M2.3a "pipe prints 'A_I/V_I = 17681.9' and 'v_d = 0.0124421'" \
    eval 'grep -q "A_I/V_I = 17681.9 1/m" "$PIPE/log" \
      && grep -q "v_d = 0.0124421 m/s" "$PIPE/log"'

  closure=$($CHECKS closure "$PIPE/$BALANCE" 1e-13)
  status=$?
  nSteps=$(grep -c '^Time = ' "$PIPE/log")
  nMonitors=$(grep -c '^Y_PbI2_g monitors: min Y .*, negative mass .* kg' \
    "$PIPE/log")
  summary=$(grep 'Phase change summary' "$PIPE/log")
  check M2.3b "pipe, 25 steps: ${closure#*: }; min Y and negative mass\
 printed in $nMonitors of $nSteps steps; '${summary#*: }'" \
    eval '[ $status -eq 0 ] && [ $nSteps -eq 25 ] \
      && [ $nMonitors -eq $nSteps ] \
      && [[ "$summary" == *"projected elements (0 significant)"* ]] \
      && [[ "$summary" == *"complementarity violations (0 significant)"* ]]'
else
  result M2.3a FAIL "serial pipe failed ($PIPE/log)"
  result M2.3b FAIL "serial pipe failed ($PIPE/log)"
fi

id=a
for d in simple411 simple221 hierarchical221
do
  c=$PC_DIR/pipe-$d
  if grep -q '^End' "$c/log" && grep -q '^End' "$PIPE/log"
  then
    closure=$($CHECKS closure "$c/$BALANCE" 1e-13)
    s1=$?
    serial=$($CHECKS compareSteps "$PIPE/$BALANCE" "$c/$BALANCE" 1e-9 gas \
      wall)
    s2=$?
    residual=$($CHECKS residualNotUsed "$c/log" "$c/$BALANCE")
    s3=$?
    check M2.4$id "pipe, 4 ranks ${DECOMPOSITION[$d]} (processor patches\
 per rank: $(processorPatches "$c")): ${closure#*: }; vs serial\
 ${serial#*: }; ${residual#*: }" \
      eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $s3 -eq 0 ]'
  else
    result M2.4$id FAIL "pipe on 4 ranks, $d, failed ($c/log)"
  fi
  id=$(echo $id | tr 'ab' 'bc')
done

if grep -q '^End' "$PIPE012/log" && grep -q '^End' "$PIPE012PAR/log" \
  && grep -q '^End' "$PIPE012HIER/log"
then
  serial=$($CHECKS compareSteps "$PIPE012/$BALANCE" "$PIPE012PAR/$BALANCE" \
    1e-9 gas wall)
  s1=$?
  closure=$($CHECKS closure "$PIPE012PAR/$BALANCE" 1e-13)
  s2=$?
  serialHier=$($CHECKS compareSteps "$PIPE012/$BALANCE" \
    "$PIPE012HIER/$BALANCE" 1e-9 gas wall)
  s3=$?
  closureHier=$($CHECKS closure "$PIPE012HIER/$BALANCE" 1e-13)
  s4=$?
  nConverged=$(grep -c 'exchange: .*, converged (' "$PIPE012/log")
  nConvergedPar=$(grep -c 'exchange: .*, converged (' "$PIPE012PAR/log")
  nConvergedHier=$(grep -c 'exchange: .*, converged (' "$PIPE012HIER/log")
  check M2.4e "pipe with run/012's outer loop (nCorr 10, tolerance 1e-5;\
 steps converged: $nConverged of 25 serial, $nConvergedPar and\
 $nConvergedHier of 25 on 4 ranks) vs serial: simple (4 1 1) ${serial#*: };\
 ${closure#*: }; hierarchical (2 2 1) ${serialHier#*: }; ${closureHier#*: }"\
    eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $s3 -eq 0 ] && [ $s4 -eq 0 ]'
else
  result M2.4e FAIL "pipe with run/012's outer loop failed ($PIPE012/log,\
 $PIPE012PAR/log, $PIPE012HIER/log)"
fi

# M2.5j: the serial state of 0.008 re-decomposed onto 4 ranks, one step
if grep -q '^End' "$PIPERS/log"
then
  rm -rf "$PIPERD"
  mkdir -p "$PIPERD"
  cp -a "$PIPERS"/system "$PIPERS"/constant "$PIPERS"/0 "$PIPERS"/0.008 \
    "$PIPERS"/case.foam "$PIPERS"/dynamicCode "$PIPERD"/
  setControl "$PIPERD" startFrom latestTime
  setControl "$PIPERD" endTime 0.012
  if decomposeWith "$PIPERD" 4 \
    "method hierarchical; coeffs { n (2 2 1); order xyz; }" -time '0,0.008'
  then
    runParallel "$PIPERD" "$SOLVER_EXE" 4 \
      || echo "Re-decomposed pipe restart failed ($PIPERD/log)"
  fi
  restartLine=$(grep 'Restart of pair PbI2_g' "$PIPERD/log" 2>/dev/null)
  relative=$(echo "$restartLine" | sed -n 's/.*(relative \([^;]*\);.*/\1/p')
  check M2.5j "pipe (Y 0.1) at 0.008, serial to 4 ranks hierarchical (2 2 1):\
 '${restartLine#*: }'; deposits and regimes of the serial elements not\
 used (warnings)" \
    eval 'grep -q "^End" "$PIPERD/log" \
      && echo "$restartLine" | grep -q "gas: Y_PbI2_g written in binary; deposits: mw_PbI2_s written in binary; exact)" \
      && python3 -c "import sys; sys.exit(0 if abs(float(\"$relative\")) <= 1e-15 else 1)" \
      && grep -q "uniform/phaseChange/phaseChangeRegimes at time 0.008 is missing or belongs to other interface elements" "$PIPERD/log" \
      && grep -q "uniform/phaseChange/phaseChangeDeposits at time 0.008 is written for other interface elements" "$PIPERD/log"'
else
  result M2.5j FAIL "2-step pipe failed ($PIPERS/log)"
fi


#------------------------------------------------------------------------------
# M2.7: model mock present, 008-011 identical to the pristine build
#------------------------------------------------------------------------------
GATE=$WORK_DIR/regression
MOCK=$PC_DIR/mock

mockCase() {
  local name=$1 dst=$2
  case "$name" in
    008|009|010|011) makeCase "$name" "$dst" \
                       && setControl "$dst" endTime 0.04 ;;
    010w) makeCase 010 "$dst" && setControl "$dst" endTime 0.036 \
            && setControl "$dst" writeInterval 3 ;;
  esac || return 1
  cat > "$dst/constant/thermochemistryProperties" <<'EOF'
FoamFile {version 2.0; format ascii; class dictionary; object thermochemistryProperties;}

model mock;   /* the coupled mock of tag 0.1, unchanged */
EOF
}

mockOk=true
mockText=""
if [ ! -f "$GATE/pristine/010w/log" ]
then
  mockOk=false
  mockText="no pristine reference in $GATE (run the M0 gate first)"
else
  echo "Running 008, 009, 010, 011, 010w with 'model mock'"
  for name in 008 009 010 011 010w
  do
    mockCase "$name" "$MOCK/$name" || exit 1
    startJob runSerial "$MOCK/$name" "$SOLVER_EXE"
  done
  waitJobs || echo "At least one mock run failed."
  for name in 008 009 010 011
  do
    out=$("$REGRESS" "$GATE/pristine/$name/log" "$MOCK/$name/log")
    if [ $? -eq 0 ]
    then
      mockText="$mockText $name log ${out#IDENTICAL: };"
    else
      echo "$out" | head -20
      mockOk=false
      mockText="$mockText $name log differs;"
    fi
  done
  out=$("$CMPFIELDS" "$GATE/pristine/010w" "$MOCK/010w")
  if [ $? -eq 0 ]
  then
    mockText="$mockText 010w ${out#IDENTICAL: }"
  else
    echo "$out" | head -20
    mockOk=false
    mockText="$mockText 010w fields differ"
  fi
fi
check M2.7 "model mock in constant/thermochemistryProperties, vs the\
 pristine build:$mockText" $mockOk


#------------------------------------------------------------------------------
# M2.8: run/012 reproduces its out_excerpt
#------------------------------------------------------------------------------
C012=$PC_DIR/run012
makeCase 012 "$C012" && setControl "$C012" endTime 0.005 || exit 1
runSerial "$C012" "$SOLVER_EXE"
# run/012/out_excerpt (outside this directory, not edited by the tests)
# holds 'Cells adjacent to WALL: 15264', which the solver prints for model
# mock only since the final M2 pass; the excerpt is compared without it
# (the line may also have been removed from run/012 already)
excerpt012=$(runCaseDir 012)/out_excerpt
excerptNow=$PC_DIR/run012.out_excerpt
grep -v '^Cells adjacent to WALL: ' "$excerpt012" > "$excerptNow"
nRemoved=$(( $(wc -l < "$excerpt012") - $(wc -l < "$excerptNow") ))
out=$("$REGRESS" -excerpt "$excerptNow" "$C012/log")
status=$?
echo "$out" | head -20
check M2.8 "run/012 out_excerpt without its 'Cells adjacent to WALL' line\
 ($nRemoved removed; model mock only): ${out%%$'\n'*}; no such line in the\
 log" \
  eval '[ $status -eq 0 ] && [ $nRemoved -le 1 ] && grep -q "^End" "$C012/log" \
    && ! grep -q "Cells adjacent to WALL" "$C012/log"'


#------------------------------------------------------------------------------
# M2.6i: the start-up warning about an unreachable outer tolerance
#------------------------------------------------------------------------------
check M2.6i "start-up warning 'The outer tolerance 1e-09 (speciesTransport)\
 is below the tolerance 1e-08 of the solver Y_PbI2_g' in the pipe log, and\
 none in run/012 (tolerance 1e-5)" \
  eval 'grep -q "The outer tolerance 1e-09 (speciesTransport) is below the tolerance 1e-08 of the solver Y_PbI2_g" "$PIPE/log" \
    && grep -q "^End" "$C012/log" \
    && ! grep -q "The outer tolerance .* is below the tolerance" "$C012/log"'

#------------------------------------------------------------------------------
# M2.9: an unpaired gas (the tracer of run/010) in run/012, model temperature,
# against the pristine build (model mock there: thermochemistryProperties is
# not read by it), and the paired gas against run/012 without the tracer
#------------------------------------------------------------------------------
TRACER=$PC_DIR/run012Tracer
TRACERP=$PC_DIR/run012Tracer-pristine

tracerCase() {
  local c=$1 d entry
  makeCase 012 "$c" && setControl "$c" endTime 0.005 \
    && setControl "$c" writeInterval 5 || return 1
  cp "$(runCaseDir 010)/0/Y_tracer" "$c/0/" || return 1
  d=$c/constant/speciesTransportProperties
  sed -i -E 's/^(  PbI2_s)$/  tracer\n\1/' "$d" && cat >> "$d" <<'EOF'

tracer {
  state             gas;
  diffusivityModel  constant;
  D                 1e-5;        /* molecular diffusivity [m2/s], as run/010 */
}
EOF
  grep -q -x '  tracer' "$d" || return 1
  d=$c/system/fvSchemes
  sed -i -E \
    's/^(  div\(phi,Y_PbI2_g\) .*)$/\1\n  div(phi,Y_tracer)   Gauss SuperBee;/' \
    "$d" && grep -q 'div(phi,Y_tracer)' "$d" || return 1
  d=$c/system/fvSolution
  entry='  Y_tracer {\n    solver          GAMG;\n    tolerance       1e-7;'
  entry+='\n    relTol          0;\n    smoother        GaussSeidel;'
  entry+='\n    directSolveCoarsest   yes;\n  }\n'
  sed -i -E "s/^(  Y_PbI2_s \\{)$/$entry\\n\\1/" "$d" \
    && grep -q '^  Y_tracer {' "$d" || return 1
  cat >> "$d" <<'EOF'

relaxationFactors {

  equations {
    Y_tracer        0.995;     /* as run/010: the relaxed unpaired path */
  }
}
EOF
}

tracerOk=false
tracerText="set-up or a run failed ($TRACER/log, $TRACERP/log)"
if buildPristine && tracerCase "$TRACER" && tracerCase "$TRACERP"
then
  runSerial "$TRACER" "$SOLVER_EXE" &
  runSerial "$TRACERP" "$PRISTINE_EXE" &
  wait
  if grep -q '^End' "$TRACER/log" && grep -q '^End' "$TRACERP/log" \
    && grep -q '^End' "$C012/log"
  then
    nTracer=$(grep -c 'Y_tracer' "$TRACER/log")
    sameLines=false
    cmp -s <(grep 'Y_tracer' "$TRACER/log") \
      <(grep 'Y_tracer' "$TRACERP/log") && [ "$nTracer" -gt 5 ] \
      && sameLines=true
    sameField=false
    cmp -s "$TRACER/0.005/Y_tracer" "$TRACERP/0.005/Y_tracer" \
      && sameField=true
    sameBalance=false
    cmp -s "$TRACER/$BALANCE" "$C012/$BALANCE" && sameBalance=true
    report='^(Integrated source|Net thermochemistry|Species balance'
    report+='|Tracked species)'
    nReport=$(grep -c -E "$report" "$TRACER/log")
    nSource=$(ls "$TRACER"/0.005/source_* 2>/dev/null | wc -l)
    nSourceP=$(ls "$TRACERP"/0.005/source_* 2>/dev/null | wc -l)
    tracerText="$nTracer Y_tracer lines identical to the pristine build's:\
 $sameLines; 0.005/Y_tracer cmp-identical: $sameField; balance file of\
 PbI2_g = run/012's without the tracer (M2.8): $sameBalance; report lines\
 of the coupled mock: $nReport; source fields written: $nSource (the\
 pristine mock run: $nSourceP)"
    $sameLines && $sameField && $sameBalance && [ "$nReport" -eq 0 ] \
      && [ "$nSource" -eq 0 ] && [ "$nSourceP" -eq 3 ] && tracerOk=true
  fi
fi
check M2.9 "unpaired gas in model temperature (run/012 with the tracer of\
 run/010, 5 steps; solveGasSpecies.H with a zero source): $tracerText" \
  $tracerOk

#------------------------------------------------------------------------------
# M2.2h: the M8-scale channel, started in the background with the channels
#------------------------------------------------------------------------------
echo "Waiting for the M8-scale channel ($CHM8)"
wait $M8_PID
if grep -q '^End' "$CHM8/log"
then
  released=$($CHECKS released "$CHM8/$BALANCE" $N0 $MPBI2 1e-14)
  s1=$?
  closure=$($CHECKS closure "$CHM8/$BALANCE" 1e-14)
  s2=$?
  check M2.2h "channel at M8 scale, window 15 s at dt = 0.22 ms, 30 s:\
 ${released#*: }; ${closure#*: } (no drift: 1.30e-13 before the M4 review,\
 round 2)" eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ]'
else
  result M2.2h FAIL "M8-scale channel failed ($CHM8/log)"
fi

# every criterion was tested; the results are in $RESULTS
exit 0

