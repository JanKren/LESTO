}

# restartCopy <continuous> <restart> <time>: the restart case holds every
# file of <time> of the continuous run (and of its processor directories:
# processor<i> uncollated, processors<N> collated)
restartCopy() {
  local src=$1 dst=$2 t=$3 d
  rm -rf "$dst"
  mkdir -p "$dst"
  cp -a "$src"/system "$src"/constant "$src"/0 "$src"/case.foam "$dst"/
  [ -e "$src/dynamicCode" ] && cp -a "$src/dynamicCode" "$dst"/
  if ls -d "$src"/processor* > /dev/null 2>&1
  then
    for d in "$src"/processor*
    do
      mkdir -p "$dst/$(basename "$d")"
      cp -a "$d/constant" "$d/0" "$d/$t" "$dst/$(basename "$d")"/
    done
  else
    cp -a "$src/$t" "$dst"/
  fi
  setControl "$dst" startFrom latestTime
}

# stripDataFormat <file> ...: removes the 'data.format' entry from the
# header of collated (decomposedBlockData) files, as in containers written
# without it; the format is then that of the header of the first block
stripDataFormat() {
  python3 - "$@" <<'PYEOF'
import re, sys
for path in sys.argv[1:]:
    data = open(path, 'rb').read()
    new, n = re.subn(rb'\n[ \t]*data\.format[ \t]+\w+;', b'', data, count=1)
    if n != 1:
        sys.exit(f'No data.format entry in {path}')
    open(path, 'wb').write(new)
PYEOF
}

# the first phaseChangeBalance file of a case (its start time directory)
balanceFile() {
