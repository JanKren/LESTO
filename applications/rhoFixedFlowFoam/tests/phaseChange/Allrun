import re, sys
p = sys.argv[1]
s = open(p).read()
new, n = re.subn(r'\nsamples \{.*?\n\}\n', '\n', s, flags=re.S)
assert n == 1
open(p, 'w').write(new)
nx, ny = 100, 24
ranks = []
for c in range(nx*ny):
    i, j = c % nx, c // nx
    ranks.append(1 if (i == 60 and j < 12) else 2 if (i in (61, 62) and j == 5)
                 else 0)
with open(sys.argv[2], 'w') as f:
    f.write('FoamFile {version 2.0; format ascii; class labelList; '
            'object cellDecomposition;}\n\n')
