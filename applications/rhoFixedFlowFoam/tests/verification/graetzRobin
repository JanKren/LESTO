keyTest() {
  local mesh run trans m2 r2 t2 fm fr ft
  mesh=$(meshKey 32)
  run=$(runKey linear zeroGradient 50 halfCell 32 4)
  trans=$(transientKey)
  fm=$(declare -f meshCase \
         | sed 's/writeCellCentres writeCellVolumes/writeCellVolumes writeCellCentres/')
  fr=$(declare -f runCase | sed 's/steps=4/steps=5/')
  ft=$(declare -f transientCase | sed 's/0\.05/0.1/g')
  m2=$(eval "$fm"; meshKey 32)
  r2=$(eval "$fr"; runKey linear zeroGradient 50 halfCell 32 4)
  t2=$(eval "$ft"; transientKey)
  echo "keys (set-up part) of the mesh Nr 32 ${mesh:33:12}, with the\
 postProcess functions of meshCase swapped ${m2:33:12}; of a run\
 ${run:33:12}, with 5 steps in runCase ${r2:33:12}; of the time-accurate run\
 ${trans:33:12}, with a write every 0.1 s in transientCase ${t2:33:12}"
  [ "$fm" != "$(declare -f meshCase)" ] && [ "$fr" != "$(declare -f runCase)" ] \
    && [ "$ft" != "$(declare -f transientCase)" ] \
    && [ "$mesh" != "$m2" ] && [ "$run" != "$r2" ] && [ "$trans" != "$t2" ]
}
out=$(keyTest)
s=$?
check M7.1o "the reuse keys of the Graetz runs follow their set-up\
 functions (plan section 35, item Q): $out" [ $s -eq 0 ]

