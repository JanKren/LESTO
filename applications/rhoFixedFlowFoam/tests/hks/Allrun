  if inventoryChannel "$c" \
    && setControl "$c" endTime 0.1 \
    && singleWallFace "$c" \
    && decomposeWith "$c" 4 'method manual; coeffs { dataFile "cellDecomposition"; }' \
         "${decomposeOptions[@]}" \
    && runParallel "$c" "$SOLVER_EXE" 4 log "${options[@]}" \
    && restartCopy "$c" "$c-restart" 0.05 \
    && runParallel "$c-restart" "$SOLVER_EXE" 4 log "${options[@]}"
  then
    same=$("$CMPFIELDS" -x uniform/time "$c" "$c-restart" 0.1)
    s1=$?
    line=$(grep 'Restart of pair PbI2_g' "$c-restart/log")
    nWarn=$(grep -c 'uniform/phaseChange/phaseChange[A-Za-z]* at time 0.05 is' \
      "$c-restart/log")
