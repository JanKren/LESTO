# step with the box moved (refused), with one cell of the selection
# replaced by the one below it (refused: 5e-6 m is within the rounding
# bound of 6-digit points, but above the limit of a one-cell change), and
# unchanged (accepted)
CHASC=$HK_DIR/channelInventoryAsciiMesh
swapCell() {
  python3 - constant/thermochemistryProperties <<'EOF2'
import sys
p = sys.argv[1]
s = open(p).read()
old = ('selection     { boat { action use; source box; '
       'box (0.01 0.002 -1) (0.02 0.0028 1); } }')
new = ('selection     { boat { action use; source box; '
       'box (0.01 0.002 -1) (0.02 0.0028 1); } '
       'out { action subtract; source box; '
       'box (0.01 0.002 -1) (0.011 0.0022 1); } '
       'in { action add; source box; '
       'box (0.01 0.0018 -1) (0.011 0.002 1); } }')
assert s.count(old) == 1
open(p, 'w').write(s.replace(old, new))
EOF2
}
if inventoryChannel "$CHASC" \
  && setControl "$CHASC" endTime 0.05 \
  && setControl "$CHASC" writeFormat ascii \
  && (cd "$CHASC" && foamFormatConvert -constant > log.foamFormatConvert 2>&1) \
  && grep -a -q -m1 'format *ascii;' "$CHASC/constant/polyMesh/points" \
  && runSerial "$CHASC" "$SOLVER_EXE"
then
  ascFatal() {
    local name=$1 text=$2 message=$3
    shift 3
    local dst=$HK_DIR/fatal-asciiMesh-$name
    restartCopy "$CHASC" "$dst" 0.05 && setControl "$dst" endTime 0.051 \
      && (cd "$dst" && "$@") && expectFatal M5.5 "$text" "$dst" "$message"
  }
  recorded=$(sed -n 's/^ *meshPoints *"\([^"]*\)";/\1/p' \
    "$CHASC/0.05/uniform/phaseChangeLayout")
  ascFatal moved "restart with the inventory sample moved by 20 mm on an\
 ascii mesh of round coordinates (recorded: meshPoints '$recorded')" \
    "a quarter of the centre shift of a selection with one cell replaced" \
    sed -i 's/box (0.01 0.002 -1) (0.02 0.0028 1);/box (0.03 0.002 -1) (0.04 0.0028 1);/' \
      constant/thermochemistryProperties
  ascFatal swap "restart with one cell of the inventory sample replaced by\
 the one below it on the same ascii mesh (the centre moves by 5e-6 m, within\
 the rounding bound of 6-digit points)" \
    "The difference lies within the rounding of the ascii mesh points" \
    swapCell
  CHASCRS=$HK_DIR/channelInventoryAsciiMesh-restart
  restartCopy "$CHASC" "$CHASCRS" 0.05 && setControl "$CHASCRS" endTime 0.051 \
    && runSerial "$CHASCRS" "$SOLVER_EXE"
  line=$(grep 'Restart of pair PbI2_g' "$CHASCRS/log" 2>/dev/null)
  check M5.5 "the unchanged restart on the ascii mesh of round coordinates\
 (meshPoints '$recorded') is accepted: '${line#*: }'" \
    eval 'grep -q "^End" "$CHASCRS/log" && [ "$recorded" = "ascii, 6 significant digits" ] \
      && grep -q "Sample boat (pair PbI2_g): 40 cells" "$CHASCRS/log"'
else
  for i in 1 2 3
  do
    result M5.5 FAIL "inventory channel on an ascii mesh failed ($CHASC/log)"
  done
fi

c=$HK_DIR/fatal-freshCs
blockCase channel "$c" > /dev/null && hksDict "$c" "" "$BOAT" \
  && sed -e 's/object Y_PbI2_g;/object Cs_PbI2_s;/' \
       -e 's/^dimensions.*/dimensions    [1 -3 0 0 0 0 0];/' \
       -e 's/type fixedValue; value uniform 0;/type calculated; value uniform 0;/' \
       -e 's/type zeroGradient;/type calculated; value uniform 0;/g' \
       "$c/0/Y_PbI2_g" > "$c/0/Cs_PbI2_s" \
  && expectFatal M5.5 "fresh start with a Cs_PbI2_s field (state without the\
 ledger)" "$c" "the reservoir field(s) 1(Cs_PbI2_s)) but not the ledger"

# removeTime 0.4 ms < deltaT/2: filled and removed in the first step
c=$HK_DIR/fatal-removeAtStart
blockCase channel "$c" > /dev/null \
  && hksDict "$c" "" "$(echo "$BOAT" | sed 's/^    removeTime    0.25;/    removeTime    0.0004;/')" \
  && grep -q '^    removeTime    0.0004;' "$c/constant/thermochemistryProperties" \
  && expectFatal M5.5 "fresh start at removeTime - deltaT/2 or later\
 (removeTime 0.4 ms, deltaT 1 ms)" "$c" \
       "would be filled and removed at the start of the first step"


#------------------------------------------------------------------------------
# M5.6: carry-over (a), wallPlusGas without the gas of the sample cells
#------------------------------------------------------------------------------
PRCH=$HK_DIR/profilesChannel
blockCase channel "$PRCH" && setControl "$PRCH" endTime 0.05 \
  && printf '\nprofiles {\n%s\n}\n' '  bins {
    native { min 0; max 0.1; nBins 100; }
    gamma  { width 0.01; }
  }
  times (0.03);' >> "$PRCH/constant/thermochemistryProperties" \
  || exit 1
runSerial "$PRCH" "$SOLVER_EXE"
if grep -q '^End' "$PRCH/log"
then
  out=$(python3 - "$PRCH" "$SOLVER_DIR" "$TESTS_DIR" <<'EOF'
import math, os, sys
sys.path.insert(0, os.path.join(sys.argv[2], 'utilities'))
sys.path.insert(0, os.path.join(sys.argv[3], 'phaseChange'))
import axialProfiles as ap
from checks import readScalarField
case = sys.argv[1]
ok = True
text = []
for path in ap.files(case):
    p = ap.read(path)
    obs, wall, gas, sg = (p.column(n) for n in
                          ('observable', 'wall', 'gas', 'sampleGas'))
    scale = max(abs(v) for v in obs) or 1
    worst = max(abs(o - (w + g - s)) for o, w, g, s in
                zip(obs, wall, gas, sg))/scale
    lo, hi = p.column('x_lo'), p.column('x_hi')
    outside = [s for s, a, b in zip(sg, lo, hi) if b <= 0.01 or a >= 0.02]
    inside = [s for s, a, b in zip(sg, lo, hi) if a < 0.02 and b > 0.01]
    # outside: at most the round-off of the axial extents of the cells at
    # the sample's edges (blockMesh points within 1e-18 m of 0.02)
    good = worst <= 1e-15 and all(abs(s) <= 1e-9*max(sg) for s in outside) \
        and all(s > 0 for s in inside)
    ok = ok and good
    text.append(f'{p.directory}/{p.set} {worst:.0e}')
# the gas of the 40 sample cells (i 10..19, j 10..13) at the write time 0.05
Y = readScalarField(os.path.join(case, '0.05', 'Y_PbI2_g'))[0]
rho = readScalarField(os.path.join(case, '0', 'rho'))[0]
V = 1e-3*2e-4*1e-3
cells = [i + 100*j for i in range(10, 20) for j in range(10, 14)]
mass = math.fsum(rho[c]*Y[c]*V for c in cells)
p = ap.read(os.path.join(case, 'postProcessing', 'axialProfiles', '0.05',
                         'PbI2_g_native.dat'))
binned = math.fsum(s*(b - a) for s, a, b in
                   zip(p.column('sampleGas'), p.column('x_lo'),
                       p.column('x_hi')))*p.molarMass
rel = abs(binned - mass)/mass
ok = ok and rel <= 1e-12
print(f'observable = wall + gas - sampleGas in every file to '
      f'{", ".join(text)}; sampleGas > 0 in the bins that overlap the '
      f'sample, at most 1e-9 of its maximum in the others (the round-off of '
      f'the cell extents at x = 0.02); its integral at 0.05 = the gas of '
      f'the 40 sample cells {mass:.10g} kg to {rel:.1e}')
sys.exit(0 if ok else 1)
EOF
)
  s1=$?
  onsetNew=$(sed -n 's/^# Tdep fromPeak status found T \([^ ]*\) .*/\1/p' \
    "$PRCH/postProcessing/axialProfiles/0.03/PbI2_g_native.dat")
  onsetWall=$($READER "$PRCH" --time 0.03 --set native \
    | sed -n 's/^  wall column: T_dep fromPeak: //p')
  check M5.6 "carry-over (a), the release channel: $out; at 0.03 T_dep\
 fromPeak of wallPlusGas $onsetNew K (M3 definition: 949.5 K; the gas\
 around the sample cells is still counted), of the wall column: $onsetWall\
 (its deposit is solver noise)" [ $s1 -eq 0 ]
else
  result M5.6 FAIL "profiles channel failed ($PRCH/log)"
fi


#------------------------------------------------------------------------------
# M5.7: carry-over (b), T_dep of a noise-level column
#------------------------------------------------------------------------------
N012=$HK_DIR/run012Noise
N012S=$HK_DIR/run012NoiseSignificance0
for c in "$N012" "$N012S"
do
  makeCase 012 "$c" && setControl "$c" endTime 0.004 || exit 1
done
printf '\nprofiles {\n%s\n}\n' '  bins { native { min 0; max 0.69; nBins 424; } }
  times (0.004);
  observable wall;' >> "$N012/constant/thermochemistryProperties"
printf '\nprofiles {\n%s\n}\n' '  bins { native { min 0; max 0.69; nBins 424; } }
  times (0.004);
  onset { significance 0; }
  observable wall;' >> "$N012S/constant/thermochemistryProperties"
runSerial "$N012" "$SOLVER_EXE" &
runSerial "$N012S" "$SOLVER_EXE" &
wait
if grep -q '^End' "$N012/log" && grep -q '^End' "$N012S/log"
then
  f1=$N012/postProcessing/axialProfiles/0.004/PbI2_g_native.dat
  f2=$N012S/postProcessing/axialProfiles/0.004/PbI2_g_native.dat
  wall=$(sed -n 's/^# inventory gas [^ ]* wall \([^ ]*\) .*/\1/p' "$f1")
  nInsignificant=$(grep -c '^# Tdep from[A-Za-z]* status insignificant' "$f1")
  nFound=$(grep -c -E '^# Tdep from[A-Za-z]* status (found|notBracketed)' "$f2")
  $READER "$N012" > "$N012/log.reader" 2>&1
  nReader=$(grep -c 'T_dep from[A-Za-z]*: none (insignificant); recomputed: insignificant' \
    "$N012/log.reader")
  logLine=$(grep -m1 'none (insignificant' "$N012/log" | sed 's/^ *//')
  check M5.7 "carry-over (b): run/012 at 0.004 s, observable wall, wall\
 inventory $wall mol: $nInsignificant searches 'insignificant' (log:\
 '${logLine:0:160}...'), the reader recomputes $nReader; with onset {\
 significance 0; } $nFound searched (found or notBracketed)" \
    eval '[ "$nInsignificant" -eq 2 ] && [ "$nFound" -eq 2 ] && [ "$nReader" -eq 2 ]'
else
  result M5.7 FAIL "run/012 noise cases failed ($N012/log, $N012S/log)"
fi


#------------------------------------------------------------------------------
# M5.8: carry-over (d), profile times of a restart with another deltaT
#------------------------------------------------------------------------------
DT=$HK_DIR/profileTimes
blockCase channel "$DT" && setControl "$DT" endTime 0.05 \
  && printf '\nprofiles {\n%s\n}\n' '  bins { native { min 0; max 0.1; nBins 100; } }
  times (0.02 0.0502 0.0508 0.07);' >> "$DT/constant/thermochemistryProperties" \
  || exit 1
runSerial "$DT" "$SOLVER_EXE"
if grep -q '^End' "$DT/log"
then
  text=""
  status=0
  record=$(sed -n '/^profiles/,/}/p' "$DT/0.05/uniform/phaseChangeLayout" \
    | tr -s ' \n' ' ')
  [[ "$record" == *'"0.02" "0.0502"'* ]] || status=1
  for spec in "0.0002|dtSmall" "0.002|dtLarge"
  do
    IFS='|' read -r dt name <<< "$spec"
    rs=$HK_DIR/profileTimes-$name
    restartCopy "$DT" "$rs" 0.05 \
      && setControl "$rs" endTime 0.08 \
      && setControl "$rs" deltaT "$dt" \
      && setControl "$rs" writeInterval 100000 \
      && sed -i -E "s/^(deltaT0?) +[^;]+;/\1 $dt;/" "$rs/0.05/uniform/time" \
      && runSerial "$rs" "$SOLVER_EXE"
    if grep -q '^End' "$rs/log" 2>/dev/null
    then
      entries=$(cat "$DT"/postProcessing/axialProfiles/*/PbI2_g_native.dat \
        "$rs"/postProcessing/axialProfiles/*/PbI2_g_native.dat \
        | sed -n 's/^# time .* reason \(.*\)/\1/p' | tr ';' '\n' \
        | sed -n 's/^ *profile time \(.*\)/\1/p' | sort -g | tr '\n' ' ')
      skipped=$(grep -o '([0-9]* skipped: written by the run that wrote the restart state[^)]*)' "$rs/log")
      text="$text deltaT $dt: entries written over both runs: $entries$skipped;"
      [ "$entries" = "0.02 0.0502 0.0508 0.07 " ] || status=1
    else
      text="$text deltaT $dt failed ($rs/log);"
      status=1
    fi
  done
  check M5.8 "carry-over (d): the channel written at 0.05 (dt 1 ms) records\
 '$record' in uniform/phaseChangeLayout; restarts:$text" [ $status -eq 0 ]
else
  result M5.8 FAIL "profile-times channel failed ($DT/log)"
fi



#------------------------------------------------------------------------------
# M5.9: inputs of the other model are named at start-up
#------------------------------------------------------------------------------
IGT=$HK_DIR/ignoredInputsTemperature
IGH=$HK_DIR/ignoredInputsHKS
blockCase closedBox "$IGT" && setControl "$IGT" endTime 0.004 \
  && python3 - "$IGT/constant/thermochemistryProperties" <<'EOF' \
  && blockCase closedBox "$IGH" at700K && setControl "$IGH" endTime 0.004 \
  && hksDict "$IGH" "" \
  && printf '\ntemperatureCoeffs { A 220; k 8e-3; Tdep 680; }\n' \
       >> "$IGH/constant/thermochemistryProperties" \
  || exit 1
import sys
p = sys.argv[1]
s = open(p).read()
old = '  PbI2_g { condensed PbI2_s; }'
assert s.count(old) == 1
s = s.replace(old, '  PbI2_g { condensed PbI2_s; vapourPressure { file "x.csv"; } }')
s += '\nHKSCoeffs { accommodation 1; }\n'
open(p, 'w').write(s)
EOF
runSerial "$IGT" "$SOLVER_EXE" &
runSerial "$IGH" "$SOLVER_EXE" &
wait
wT=$(grep -c -F 'Model temperature does not read HKSCoeffs pairs/PbI2_g/vapourPressure (inputs of the other model)' "$IGT/log")
wH=$(grep -c -F 'Model HKS does not read temperatureCoeffs (inputs of the other model)' "$IGH/log")
check M5.9 "inputs of the other model named at start-up: model temperature\
 with HKSCoeffs and a vapourPressure of the pair: $wT warning; model HKS with\
 temperatureCoeffs: $wH warning; both runs end" \
  eval '[ "$wT" -eq 1 ] && [ "$wH" -eq 1 ] && grep -q "^End" "$IGT/log" \
    && grep -q "^End" "$IGH/log"'

# every criterion was tested; the results are in $RESULTS
exit 0

