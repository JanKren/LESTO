  check M5.2g "pipe run/013 at 0.1, serial to 4 ranks (hierarchical 1 2 2)\
 and back (reconstructPar at 0.108): restarts re-read from Cs_PbI2_s and\
 exact: $nPar and $nSer; V_Z of the boat as written by the serial, the\
 parallel and the reconstructed run: $volumes m3; ${closurePar#*: };\
 ${closureSer#*: }" \
    eval 'grep -q "^End" "$PIPERD/log.parallel" && grep -q "^End" "$PIPERD/log.serial" \
      && [ "$nPar" -eq 1 ] && [ "$nSer" -eq 1 ] && [ $s1 -eq 0 ] && [ $s2 -eq 0 ]'
