# M5.2o: the tolerance of the recorded V_Z and centre follows the rounding
# of the mesh points of both runs (review of M5, round 3).  (a) The state of
# M5.2m (processor meshes in ascii) reconstructed and continued for 1 step
# on the original binary mesh: the record of the ascii run carries its
# bounds.  (b) The boat moved to x 0.60-0.61 m (the same 144 cells of
# different volumes), 1 serial step, then decomposed with writeFormat
# ascii at writePrecision 10 and 12 and 1 step on 4 ranks: the V_Z error
# of rounded points grows with |x|/cell size.  The round-3 build refused
# all three as 'changed'
PIPEASCREC=$HK_DIR/pipe013RedecomposedAsciiReconstructed
PIPEFAR=$HK_DIR/pipe013FarBoat
text=""
status=0
if grep -q '^End' "$PIPEASC/log" 2>/dev/null
then
  rm -rf "$PIPEASCREC"
  mkdir -p "$PIPEASCREC"
  cp -a "$PIPEASC"/system "$PIPEASC"/constant "$PIPEASC"/0 \
    "$PIPEASC"/case.foam "$PIPEASC"/dynamicCode "$PIPEASCREC"/
  for d in "$PIPEASC"/processor*
  do
    mkdir -p "$PIPEASCREC/$(basename "$d")"
    cp -a "$d/constant" "$d/0" "$d/0.104" "$PIPEASCREC/$(basename "$d")"/
  done
  (cd "$PIPEASCREC" && reconstructPar -time 0.104 > log.reconstructPar 2>&1) \
    && setControl "$PIPEASCREC" endTime 0.108 \
    && runSerial "$PIPEASCREC" "$SOLVER_EXE"
  if grep -q '^End' "$PIPEASCREC/log"
  then
    points=$(grep -a -m1 -o 'format *[a-z]*;' "$PIPEASCREC/constant/polyMesh/points" \
      | sed 's/format *//; s/;//')
    written=$(sed -n 's/^ *meshPoints *"\([^"]*\)";/\1/p' \
      "$PIPEASC/processor0/0.104/uniform/phaseChangeLayout")
    now=$(sed -n 's/^ *meshPoints *"\([^"]*\)";/\1/p' \
      "$PIPEASCREC/0.108/uniform/phaseChangeLayout")
    volumes=$(sed -n 's/^ *volume *"\([^"]*\)";/\1/p' \
      "$PIPEASC/processor0/0.104/uniform/phaseChangeLayout" \
      "$PIPEASCREC/0.108/uniform/phaseChangeLayout" | tr '\n' ' ' | sed 's/ $//')
    cells=$(grep -m1 -o 'Sample boat (pair PbI2_g): [0-9]* cells' "$PIPEASCREC/log")
    closure=$($PCCHECKS closure "$PIPEASCREC/postProcessing/phaseChangeBalance/0.104/PbI2_g.dat" 1e-13) \
      || status=1
    [ "$points" = binary ] && [ "$written" = "ascii, 10 significant digits" ] \
      && [ "$now" = binary ] && [ "$cells" = "Sample boat (pair PbI2_g): 144 cells" ] \
      || status=1
    text="$text (a) reconstructed onto the binary mesh (points $points): $cells,\
 accepted; meshPoints recorded by the ascii run '$written', by this run\
 '$now'; V_Z $volumes m3; ${closure#*: };"
  else
    text="$text (a) the serial restart of the reconstructed state failed\
 ($PIPEASCREC/log: $(grep -m1 -A2 'FATAL' "$PIPEASCREC/log" | tail -2 | tr -s ' \n' ' '));"
    status=1
  fi
else
  text="$text (a) M5.2m failed;"
  status=1
fi
if grep -q '^End' "$PIPE/log"
then
  rm -rf "$PIPEFAR"
  mkdir -p "$PIPEFAR"
  cp -a "$PIPE"/system "$PIPE"/constant "$PIPE"/0 "$PIPE"/case.foam \
    "$PIPE"/dynamicCode "$PIPEFAR"/
  edit "$PIPEFAR/constant/thermochemistryProperties" \
    's/^( +point1 +)\(0.04 0 0\);/\1(0.60 0 0);/; s/^( +point2 +)\(0.05 0 0\);/\1(0.61 0 0);/' \
    'point2 +\(0.61 0 0\);' \
    && setControl "$PIPEFAR" endTime 0.004 \
    && setControl "$PIPEFAR" writeInterval 1 \
    && runSerial "$PIPEFAR" "$SOLVER_EXE" || status=1
  for P in 10 12
  do
    c=$PIPEFAR-ascii$P
    rm -rf "$c"
    mkdir -p "$c"
    cp -a "$PIPEFAR"/system "$PIPEFAR"/constant "$PIPEFAR"/0 "$PIPEFAR"/0.004 \
      "$PIPEFAR"/case.foam "$PIPEFAR"/dynamicCode "$c"/ 2>/dev/null
    setControl "$c" startFrom latestTime \
      && setControl "$c" endTime 0.008 \
      && edit "$c/system/controlDict" \
           "s/^writeFormat .*$/writeFormat ascii;\nwritePrecision $P;/" \
           "^writePrecision $P;" \
      && printf '%s\n' 'FoamFile{version 2.0; format ascii; class dictionary; object decomposeParDict;}' \
           'numberOfSubdomains 4;' 'method hierarchical;' 'coeffs { n (1 2 2); }' \
           > "$c/system/decomposeParDict" \
      && (cd "$c" && decomposePar -force -time '0,0.004' > log.decomposePar 2>&1) \
      && runParallel "$c" "$SOLVER_EXE" 4
    if grep -q '^End' "$c/log" 2>/dev/null
    then
      cells=$(grep -m1 -o 'Sample boat (pair PbI2_g): [0-9]* cells' "$c/log")
      now=$(sed -n 's/^ *meshPoints *"\([^"]*\)";/\1/p' \
        "$c/processor0/0.008/uniform/phaseChangeLayout")
      volumes=$(sed -n 's/^ *volume *"\([^"]*\)";/\1/p' \
        "$PIPEFAR/0.004/uniform/phaseChangeLayout" \
        "$c/processor0/0.008/uniform/phaseChangeLayout" | tr '\n' ' ' | sed 's/ $//')
      closure=$($PCCHECKS closure "$c/postProcessing/phaseChangeBalance/0.004/PbI2_g.dat" 1e-13) \
        || status=1
      [ "$cells" = "Sample boat (pair PbI2_g): 144 cells" ] \
        && [ "$now" = "ascii, $P significant digits" ] \
        && grep -m1 'Restart of pair PbI2_g' "$c/log" | grep -q '; rounded)' \
        || status=1
      text="$text (b) writePrecision $P: $cells, accepted, meshPoints '$now';\
 V_Z serial and ascii $volumes m3; ${closure#*: };"
    else
      text="$text (b) writePrecision $P failed ($c/log: $(grep -m1 -A2 'FATAL' "$c/log" 2>/dev/null | tail -2 | tr -s ' \n' ' '));"
      status=1
    fi
  done
else
  text="$text (b) pipe run/013 failed;"
  status=1
fi
check M5.2o "the V_Z and centre of an inventory sample within the bounds\
 of the point rounding of both runs:$text" [ $status -eq 0 ]

# M5.2h: the removed sample dropped at the restart from 0.3 (to 0.31), a
# second restart (to 0.32), and a third with the sample re-added (to 0.33)
CHDROP=$HK_DIR/channelInventoryDropped
dropSamples() {
  python3 - "$1/constant/thermochemistryProperties" <<'EOF'
import re, sys
p = sys.argv[1]
s = open(p).read()
s, n = re.subn(r'\nsamples \{.*\n\}\n', '\n', s, flags=re.S)
assert n == 1
open(p, 'w').write(s)
EOF
}
if grep -q '^End' "$CH/log"
then
  restartCopy "$CH" "$CHDROP" 0.3 \
    && cp "$CHDROP/constant/thermochemistryProperties" "$CHDROP/thermo.withSample" \
    && dropSamples "$CHDROP" \
    && setControl "$CHDROP" writeInterval 10 \
    && setControl "$CHDROP" endTime 0.31 \
    && runSerial "$CHDROP" "$SOLVER_EXE" log.1 \
    && setControl "$CHDROP" endTime 0.32 \
    && runSerial "$CHDROP" "$SOLVER_EXE" log.2 \
    && cp "$CHDROP/thermo.withSample" "$CHDROP/constant/thermochemistryProperties" \
    && setControl "$CHDROP" endTime 0.33 \
    && runSerial "$CHDROP" "$SOLVER_EXE" log.3
  ended=$(cat "$CHDROP"/log.[123] 2>/dev/null | grep -c '^End')
  kept=$(cat "$CHDROP"/log.[12] 2>/dev/null \
    | grep -c -F 'Sample boat (mode inventory, removed at t = 0.25000000000000017 s) is no longer in the dictionary; its record is kept')
  exact=$(cat "$CHDROP"/log.[123] 2>/dev/null \
    | grep -c 'Restart of pair PbI2_g: the inventory re-read differs from the ledger by 0 kg .*exact)')
  empty=$(grep -c -F 'Sample boat was removed at t = 0.25 s by the run that wrote the state; it stays empty' \
    "$CHDROP/log.3" 2>/dev/null)
  layout=$($CHECKS layoutSample "$CHDROP/0.32/uniform/phaseChangeLayout" boat removed yes)
  s1=$?
  closure=$($PCCHECKS closure "$CHDROP/postProcessing/phaseChangeBalance/0.32/PbI2_g.dat" 1e-13)
  s2=$?
  check M5.2h "inventory channel with the removed sample dropped at 0.3,\
 restarted again at 0.31 and re-added at 0.32: runs ended $ended of 3;\
 'its record is kept' in $kept runs; exact restarts: $exact; the re-added\
 sample stays empty: $empty; ${layout#*: } at 0.32; the last run:\
 ${closure#*: }" \
    eval '[ "$ended" -eq 3 ] && [ "$kept" -eq 2 ] && [ "$exact" -eq 3 ] \
      && [ "$empty" -eq 1 ] && [ $s1 -eq 0 ] && [ $s2 -eq 0 ]'
else
  result M5.2h FAIL "inventory channel failed ($CH/log)"
fi

# M5.2i: a release sample added in front of the inventory sample at the
# restart from 0.2; its window begins at 0.31, so nothing changes up to 0.3
# (a window from 0.3 would not do: the exact clock of the step ending at 0.3
# is 0.30000000000000021, so that step would release)
CHPUFF=$HK_DIR/channelInventoryAddRelease
addPuff() {
  python3 - "$1/constant/thermochemistryProperties" <<'EOF'
import sys
p = sys.argv[1]
s = open(p).read()
puff = ('  puff { pair PbI2_g; selection { puff { action use; source box; '
        'box (0.05 0.002 -1) (0.06 0.0028 1); } } mode release; '
        'amount 1e-7; startTime 0.31; duration 0.01; }\n')
assert s.count('\nsamples {\n') == 1
s = s.replace('\nsamples {\n', '\nsamples {\n' + puff)
open(p, 'w').write(s)
EOF
}
if grep -q '^End' "$CH/log"
then
  restartCopy "$CH" "$CHPUFF" 0.2 \
    && setControl "$CHPUFF" endTime 0.3 \
    && addPuff "$CHPUFF" \
    && runSerial "$CHPUFF" "$SOLVER_EXE"
  same=$("$CMPFIELDS" -x uniform/time -x uniform/phaseChangeLayout "$CH" \
    "$CHPUFF" 0.25 0.3)
  s1=$?
  warnings=$(grep -c -E 'uniform/phaseChange/phase[A-Za-z]* at time 0.2 is (written for other|missing or belongs to other)' \
    "$CHPUFF/log" 2>/dev/null)
  exact=$(grep -c 'Restart of pair PbI2_g: the inventory re-read differs from the ledger by 0 kg .*reservoirs: uniform/phaseChange/phaseChangeReservoirs; exact)' \
    "$CHPUFF/log" 2>/dev/null)
  check M5.2i "inventory channel restarted at 0.2 with a release sample\
 (window from 0.31 s) in front of the inventory sample: warnings about\
 uniform/ at 0.2: $warnings; reservoirs from uniform/ and exact: $exact;\
 fields at 0.25 and 0.3 vs the continuous run: ${same%%$'\n'*}" \
    eval 'grep -q "^End" "$CHPUFF/log" && [ $s1 -eq 0 ] \
      && [ "$warnings" -eq 0 ] && [ "$exact" -eq 1 ]'
else
  result M5.2i FAIL "inventory channel failed ($CH/log)"
fi

# M5.2n: the collated file handler with another number of ranks (review of
# M5, round 3).  The inventory channel on 2 ranks with -fileHandler collated
# to 0.2; its state reconstructed (reconstructPar -fileHandler collated) and
# continued in serial across the removal to 0.3, and re-decomposed with the
# collated handler onto 4 ranks and continued there.  The ledger and the
# layout are global, plain files that both read; the per-rank lists are
# containers of 2 blocks, which neither can read: the state comes from mw_
# and Cs_ (before the fix both restarts stopped with a FatalIOError of the
# file handler)
CHCOL=$HK_DIR/channelInventory-collated2
CHCOLSER=$HK_DIR/channelInventory-collated2-reconstructed
CHCOL4=$HK_DIR/channelInventory-collated2-to4
collatedCopy() {
  rm -rf "$2"
  mkdir -p "$2/processors2"
  cp -a "$1"/system "$1"/constant "$1"/0 "$1"/case.foam "$2"/ \
    && cp -a "$1"/processors2/constant "$1"/processors2/0 \
         "$1"/processors2/0.2 "$2"/processors2/ \
    && setControl "$2" startFrom latestTime \
    && setControl "$2" endTime 0.3 \
    && (cd "$2" && reconstructPar -fileHandler collated -time 0.2 \
          > log.reconstructPar 2>&1)
}
# (no result of an earlier invocation may survive a failed step)
rm -rf "$CHCOL" "$CHCOLSER" "$CHCOL4"
if inventoryChannel "$CHCOL" \
  && setControl "$CHCOL" endTime 0.2 \
  && decomposeWith "$CHCOL" 2 "method simple; coeffs { n (2 1 1); }" \
       -fileHandler collated \
  && runParallel "$CHCOL" "$SOLVER_EXE" 2 log -fileHandler collated
then
  collatedCopy "$CHCOL" "$CHCOLSER" \
    && runSerial "$CHCOLSER" "$SOLVER_EXE"
  collatedCopy "$CHCOL" "$CHCOL4" \
    && rm -rf "$CHCOL4/processors2" \
    && decomposeWith "$CHCOL4" 4 "method simple; coeffs { n (4 1 1); }" \
         -fileHandler collated -time '0,0.2' \
    && runParallel "$CHCOL4" "$SOLVER_EXE" 4 log -fileHandler collated
fi
# the kind of every file of uniform/ at 0.2 of the 2-rank run: a container
# of the collated handler (per rank) or a plain list (global)
kinds=""
for f in phaseChangeBalance phaseChangeLayout phaseChange/phaseChangeDeposits \
  phaseChange/phaseChangeRegimes phaseChange/phaseChangeReservoirs
do
  if grep -a -q -m1 'class *decomposedBlockData' \
    "$CHCOL/processors2/0.2/uniform/$f" 2>/dev/null
  then
    kinds="$kinds $f container,"
  elif [ -f "$CHCOL/processors2/0.2/uniform/$f" ]
  then
    kinds="$kinds $f plain,"
  else
    kinds="$kinds $f missing,"
  fi
done
kinds=${kinds%,}
text=""
status=0
[[ "$kinds" == " phaseChangeBalance plain, phaseChangeLayout plain,\
 phaseChange/phaseChangeDeposits container, phaseChange/phaseChangeRegimes\
 container, phaseChange/phaseChangeReservoirs container" ]] || status=1
for spec in "$CHCOLSER|a serial run" "$CHCOL4|this run on 4 ranks"
do
  IFS='|' read -r c who <<< "$spec"
  if grep -q '^End' "$c/log" 2>/dev/null
  then
    line=$(grep 'Restart of pair PbI2_g' "$c/log")
    relative=$(echo "$line" | sed -n 's/.*(relative \([^;]*\);.*/\1/p')
    nForeign=$(grep -c "uniform/phaseChange/phaseChange[A-Za-z]* at time 0.2 is a container of the collated file handler written on 2 ranks, which $who cannot read" "$c/log")
    n=$(count "$c/log" "^Sample boat removed at")
    closure=$($PCCHECKS closure "$c/postProcessing/phaseChangeBalance/0.2/PbI2_g.dat" 1e-13) \
      || status=1
    echo "$line" | grep -q "deposits: mw_PbI2_s written in binary; reservoirs: Cs_PbI2_s written in binary; exact)" \
      && python3 -c "import sys; sys.exit(0 if abs(float('$relative')) <= 1e-15 else 1)" \
      && [ "$nForeign" -eq 3 ] && [ "$n" -eq 1 ] || status=1
    text="$text $(basename "$c"): '${line#*: }', $nForeign warnings\
 'a container of the collated file handler written on 2 ranks, which $who\
 cannot read' (deposits, regimes, reservoirs), $n removal, ${closure#*: };"
  else
    text="$text $(basename "$c") failed ($c/log);"
    status=1
  fi
done
check M5.2n "the inventory channel on 2 ranks with -fileHandler collated to\
 0.2; uniform/ of processors2/0.2:$kinds; its state reconstructed and\
 continued in serial, and re-decomposed (collated) onto 4 ranks, to 0.3\
 across the removal:$text" [ $status -eq 0 ]

# M5.2q: restarts on the same ranks and decomposition with the file
# handlers that read on the master (review of M5, round 4).  The inventory
# channel on 4 ranks, a manual split in which rank 1 holds a single WALL
# face, to 0.1 with -fileHandler masterUncollated, and with -fileHandler
# collated -ioRanks '(0 2)' (containers processors4_0-1 and
# processors4_2-3), each restarted from 0.05 with the same handler.  The
# per-rank lists lie in uniform/phaseChange/: in uniform/ itself these
# handlers resolved them to the master's file (or the container of rank 0's
