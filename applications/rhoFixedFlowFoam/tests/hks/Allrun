# the carrier generator of tests/phaseChange, rebuilt when its source or
# OpenFOAM changes
buildMakeCarrier() {
  local key
  key="$WM_PROJECT_DIR $(cat "$PC_SRC"/makeCarrier/makeCarrier.C \
    "$PC_SRC"/makeCarrier/Make/* | md5sum | cut -d' ' -f1)"
  if [ -x "$MAKE_CARRIER" ] \
    && [ "$(cat "$HK_DIR/bin/key" 2>/dev/null)" = "$key" ]
  then
    return 0
  fi
  rm -rf "$HK_DIR/makeCarrier" "$HK_DIR/bin"
  mkdir -p "$HK_DIR/bin"
  cp -r "$PC_SRC/makeCarrier" "$HK_DIR/makeCarrier"
  (cd "$HK_DIR/makeCarrier" && FOAM_USER_APPBIN=$HK_DIR/bin wmake) \
    > "$HK_DIR/log.makeCarrier" 2>&1 || {
      echo "Building makeCarrier failed, see $HK_DIR/log.makeCarrier" >&2
      return 1
    }
  echo "$key" > "$HK_DIR/bin/key"
}

# blockCase <template of tests/phaseChange> <destination> [<command> ...]:
# copy, run the optional command in the copy, blockMesh, carrier
blockCase() {
  local template=$1 dst=$2
  shift 2
  rm -rf "$dst"
  cp -r "$PC_SRC/$template" "$dst" \
    && (cd "$dst" && { [ $# -eq 0 ] || "$@"; } \
        && blockMesh > log.blockMesh 2>&1 \
        && "$MAKE_CARRIER" > log.makeCarrier 2>&1) \
    || { echo "Setting up $dst failed" >&2; return 1; }
  touch "$dst/case.foam"
}

# edit <file> <sed expression> <pattern that must match afterwards>
edit() {
  sed -i -E "$2" "$1" && grep -q -E "$3" "$1" \
    || { echo "Editing $1 with '$2' failed" >&2; return 1; }
}

# blockCase hook: the box at 700 K
at700K() {
  edit system/carrierDict 's/^Tin +500;/Tin       700;/; s/^Tout +500;/Tout      700;/' \
    '^Tout +700;' \
    && sed -i 's/uniform 500;/uniform 700;/g' 0/T
}

# hksDict <case> <interface entries> [<samples dictionary body>]: model HKS
# with the Gurvich table (copied into constant/), SI
hksDict() {
  cp "$PV_TABLE" "$1/constant/" || return 1
  cat > "$1/constant/thermochemistryProperties" <<EOF
FoamFile {version 2.0; format ascii; class dictionary; object thermochemistryProperties;}

model HKS;

pairs {
  PbI2_g {
    condensed PbI2_s;
    vapourPressure {
      file          "<constant>/pv_PbI2_phases.csv";
      phases        ("PbI2(cr)" "PbI2(l)");
      units         log10Pa;
      interpolation logInverseT;
      outOfRange    extrapolate;
    }
  }
}

interface {
  patches (WALL);
$2
}

HKSCoeffs { accommodation 1; Ce 1; kineticScale 1; equilibrium table; }

balance { nGuard 3; guardTolerance 1e-12; }
EOF
  if [ -n "${3:-}" ]
  then
    printf '\nsamples {\n%s\n}\n' "$3" \
      >> "$1/constant/thermochemistryProperties"
  fi
}

# the inventory sample of the channel
BOAT='  boat {
    pair          PbI2_g;
    selection     { boat { action use; source box; box (0.01 0.002 -1) (0.02 0.0028 1); } }
    mode          inventory;
    amount        4.84e-6;
    areaPerVolume 4000;
    removeTime    0.25;
  }'

# the solves of the prototype evidence: tight, no Final dictionary
tightSolvers() {
  cat > "$1/system/fvSolution" <<'EOF'
FoamFile {version 2.0; format ascii; class dictionary; object fvSolution;}

solvers {
  Y_PbI2_g {solver PBiCGStab; preconditioner DILU; tolerance 1e-15; relTol 0;}
  Y_PbI2_s {solver diagonal;}
}
EOF
}

# setY0 <case> <value>: uniform initial gas
setY0() {
  edit "$1/0/Y_PbI2_g" "s/^internalField +uniform [^;]+;/internalField uniform $2;/" \
    "^internalField uniform $2;"
}

# expectFatal <id> <text> <case> <message>: the run fails with the message
expectFatal() {
  local id=$1 text=$2 c=$3 message=$4
  if runSerial "$c" "$SOLVER_EXE"
  then
    result "$id" FAIL "$text: the run did not stop ($c/log)"
  elif grep -q -F -- "$message" "$c/log"
  then
    result "$id" PASS "$text: stops with '$message'"
  else
    result "$id" FAIL "$text: stopped without '$message' ($c/log)"
  fi
}

# decomposeWith <case> <n> <method and coeffs> [decomposePar options]
decomposeWith() {
  local c=$1 n=$2 method=$3
  shift 3
