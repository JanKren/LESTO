  line=$(grep -m1 'Restart of pair PbI2_g' "$PIPEASC/log" 2>/dev/null)
  cells=$(grep -m1 -o 'Sample boat (pair PbI2_g): [0-9]* cells' "$PIPEASC/log" 2>/dev/null)
  volumes=$(sed -n 's/^ *volume *"\([^"]*\)";/\1/p' \
