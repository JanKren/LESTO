  closure=$($PCCHECKS closure "$CHRD/postProcessing/phaseChangeBalance/0.2/PbI2_g.dat" 1e-13)
  check M5.2f "inventory channel at 0.2, serial to 4 ranks simple (4 1 1):\
 '${line#*: }'; ${closure#*: }" \
    eval 'grep -q "^End" "$CHRD/log" \
      && echo "$line" | grep -q "reservoirs: Cs_PbI2_s written in binary; exact)" \
