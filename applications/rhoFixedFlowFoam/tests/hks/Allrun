    "$PIPEASC/processor0/0.104/uniform/phaseChangeLayout" 2>/dev/null | tr '\n' ' ')
  closure=$($PCCHECKS closure "$PIPEASC/postProcessing/phaseChangeBalance/0.1/PbI2_g.dat" 1e-13)
  s1=$?
  check M5.2m "pipe run/013 at 0.1 decomposed onto 4 ranks with writeFormat\
 ascii (processor points: $points): $cells; restart '${line#*: }'; V_Z of\
 the boat as written by the serial run and the ascii-decomposed one:\
 $volumes m3 (the rounding of the points; the round-2 build refused the\
 restart as 'changed' with the tolerance 1e-12); ${closure#*: }" \
    eval 'grep -q "^End" "$PIPEASC/log" && [ "$points" = ascii ] \
      && [ "$cells" = "Sample boat (pair PbI2_g): 144 cells" ] \
      && [ "$(echo $volumes | wc -w)" -eq 2 ] \
      && echo "$line" | grep -q "; rounded)" && [ $s1 -eq 0 ]'
