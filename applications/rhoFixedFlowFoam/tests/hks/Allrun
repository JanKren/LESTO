          | sed 's/[^0-9]//g'
      done | tr '\n' ' ')
    text="$text $(basename "$c") (cells per rank $cells): ${out#*: }, $n\
 removal;"
  else
    text="$text $(basename "$c") failed ($c/log);"
    status=1
  fi
done
check M5.2d "4 ranks:$text" [ $status -eq 0 ]

if grep -q '^End' "$CHCLOCK/log"
then
  removal=$($CHECKS removal "$CHCLOCK/postProcessing/phaseChangeBalance/10/PbI2_g.dat" \
    10.0011 0.00022 10 15)
  s1=$?
  line=$(grep '^Sample boat removed at' "$CHCLOCK/log")
  check M5.2e "channel from t = 10 s, dt = 0.22 ms, removeTime 10.0011 s:\
 ${removal#*: }; log '$line'" \
    eval '[ $s1 -eq 0 ] && [ "$(count "$CHCLOCK/log" "^Sample boat removed at")" -eq 1 ]'
