  closurePar=$($PCCHECKS closure "$PIPERD/postProcessing/phaseChangeBalance/0.1/PbI2_g.dat" 1e-13)
  s1=$?
  closureSer=$($PCCHECKS closure "$PIPERD/postProcessing/phaseChangeBalance/0.108/PbI2_g.dat" 1e-13)
