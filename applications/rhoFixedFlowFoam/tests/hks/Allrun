singleWallFace() {
  python3 - "$1/constant/cellDecomposition" <<'EOF2'
import sys
nx, ny = 100, 24
ranks = []
for c in range(nx*ny):
    i, j = c % nx, c // nx
    if i < 20:
        r = 0
    elif i < 30:
        r = 1 if (i == 20 and j == 0) or 1 <= j <= 22 else 2
    elif i < 60:
        r = 2
    else:
        r = 3
    ranks.append(r)
with open(sys.argv[1], 'w') as f:
    f.write('FoamFile {version 2.0; format ascii; class labelList; '
            'object cellDecomposition;}\n\n')
    f.write(f'{len(ranks)}\n(\n' + '\n'.join(map(str, ranks)) + '\n)\n')
EOF2
}
