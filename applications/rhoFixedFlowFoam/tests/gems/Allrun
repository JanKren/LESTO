#------------------------------------------------------------------------------
# M9.14 (needs no bridge): the ledger refuses a value that is not finite
# (plan section 35, item X).  Stand-in balance files with the header of the
# channel and three steps, and stand-in logs with two Balance lines.
#------------------------------------------------------------------------------
finiteTest() {
  local d=$GE_DIR/finiteTest kind out got wrong= n=0
  rm -rf "$d"
  mkdir -p "$d"
  python3 - "$d" <<'EOF' || return 1
import os, sys
d = sys.argv[1]
header = ('# phase-change mass balance of PbI2_g [kg] (a stand-in)\n'
          '# time gas wall sample initial released transport_INLET '
          'transport_OUTLET transport_WALL removed clamped solverDefect '
          'restart projected evaporatedAboveWarning closure\n')
rows = [['0.001', '1e-7', '2e-8', '1.88e-6', '2e-6', '0', '0', '0', '0', '0',
         '0', '1e-22', '0', '0', '0', '1e-22'],
        ['0.002', '1.5e-7', '4e-8', '1.81e-6', '2e-6', '0', '0', '0', '0',
         '0', '0', '2e-22', '0', '0', '0', '2e-22'],
        ['0.003', '1.8e-7', '6e-8', '1.76e-6', '2e-6', '0', '0', '0', '0',
         '0', '0', '3e-22', '0', '0', '0', '3e-22']]
changes = {'finite': None, 'closureNaN': (1, 15, 'nan'),
           'solverDefectNaN': (2, 11, 'nan'), 'gasInf': (0, 1, 'inf')}
for name, change in changes.items():
    r = [list(x) for x in rows]
    if change:
        r[change[0]][change[1]] = change[2]
    open(os.path.join(d, name + '.dat'), 'w').write(
        header + ''.join(' '.join(x) + '\n' for x in r))
line = ('Balance PbI2_g [mol]: gas 1e-7 wall 0 sample 1.9e-6 closure 1e-22 '
        '(relative %s)\n')
open(os.path.join(d, 'finite.log'), 'w').write(line % '5e-17' + line % '1e-16')
open(os.path.join(d, 'closureNaN.log'), 'w').write(line % '5e-17' + line % 'nan')
EOF
  for kind in finite closureNaN solverDefectNaN gasInf
  do
    out=$(ledger "$d" "$d/$kind.dat" 2>&1)
    got=$?
    n=$((n + 1))
    if [ $kind = finite ]
    then
      [ $got -eq 0 ] || wrong+="${wrong:+, }$kind refused"
    elif [ $got -eq 0 ]
    then
      wrong+="${wrong:+, }$kind passed"
    elif ! echo "$out" | grep -q 'Not finite'
    then
      wrong+="${wrong:+, }$kind refused without naming the value"
    fi
  done
  for kind in finite closureNaN
  do
    out=$($PCCHECKS logClosure "$d/$kind.log" 1e-13 2>&1)
    got=$?
    n=$((n + 1))
    if [ $kind = finite ]
    then
      [ $got -eq 0 ] || wrong+="${wrong:+, }the log $kind refused"
    elif [ $got -eq 0 ]
    then
      wrong+="${wrong:+, }the log $kind passed"
    elif [[ "$out" != *"not finite"* ]]
    then
      wrong+="${wrong:+, }the log $kind refused without naming it"
    fi
  done
  echo "$n stand-ins: ledger on balance files (finite; the closure NaN in\
 the second of three rows; the solverDefect NaN in the last; the gas inf\
 in the first) and logClosure on logs (finite; a NaN closure in the second\
 Balance line): the finite ones met, the others refused: ${wrong:-all as\
 expected}"
  [ -z "$wrong" ] && [ "$n" -eq 6 ]
}
finiteOut=$(finiteTest)
finiteStatus=$?
check M9.14 "the ledger and logClosure refuse a value that is not finite\
 (plan section 35, item X): $finiteOut" [ $finiteStatus -eq 0 ]


