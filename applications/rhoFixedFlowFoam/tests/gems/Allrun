      echo "logDirectory ${LOGDIR_VALUE[$d]}: ${out#*: }; $l"
    else
      echo "logDirectory ${LOGDIR_VALUE[$d]}: the run failed ($c/log)"
      s=1
    fi
  done
  return $s
}
dirs=$(logDirs)
s1=$?
check M9.12 "the log directory of every rank on 4 ranks (plan section 35,\
 item D): ${dirs//$'\n'/; }" [ $s1 -eq 0 ]


#------------------------------------------------------------------------------
# M9.13: 64-bit counts
#------------------------------------------------------------------------------
if grep -q '^End' "$COUNT64/log"
then
  counts=$($CHECKS iterations "$COUNT64/log" "$COUNT64" 4 1000000000)
  s1=$?
  l=$(ledger "$COUNT64")
  s2=$?
  check M9.13 "64-bit counts (plan section 35, item A), 3 steps on 4 ranks\
 with the fault bridge reporting 1e9 IPM iterations per call:\
 ${counts#*: }; $l" eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ]'
else
  result M9.13 FAIL "the 4-rank run with 1e9 iterations per call failed\
 ($COUNT64/log)"
fi

# every criterion was tested; the results are in $RESULTS
exit 0

