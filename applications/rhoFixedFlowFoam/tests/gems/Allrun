# M9.8: run/015
#------------------------------------------------------------------------------

# excerptVerdict <excerpt> <log> <md5 of the bridge of the run> <directory>:
# 'PASS', 'FAIL' or 'NOTRUN' and the text (plan section 35, item V).  With
# the bridge that wrote the excerpt the whole excerpt (the start-up and 5
# steps) is compared exactly.  With another bridge only what no GEMS3K call
# reaches, the start-up and step 1 (no element has gas at t = 0, so the
# update of step 1 makes no call), up to the second 'Time = ' line of the
# excerpt (written to <directory>): DIFFERENT is a FAIL whatever the
# bridge, IDENTICAL leaves the rest NOTRUN.
excerptVerdict() {
  local excerpt=$1 log=$2 md5=$3 d=$4 out status own=${EXCERPT_BRIDGE_MD5:0:12}
  if [ "$md5" = "$EXCERPT_BRIDGE_MD5" ]
  then
    out=$("$REGRESS" -excerpt "$excerpt" "$log")
    status=$?
    echo "$([ $status -eq 0 ] && echo PASS || echo FAIL) the whole excerpt\
 with the bridge that wrote it (md5 $own...): ${out%%$'\n'*}"
    return
  fi
  mkdir -p "$d"
  awk '/^Time = / { n++ } n == 2 { exit } { print }' "$excerpt" \
    > "$d/excerptStep1"
  echo '...' >> "$d/excerptStep1"
  out=$("$REGRESS" -excerpt "$d/excerptStep1" "$log")
  status=$?
  if [ $status -eq 0 ]
  then
    echo "NOTRUN another bridge (md5 ${md5:0:12}..., the excerpt's\
 $own...): the start-up and step 1, which no GEMS3K call reaches,\
 ${out%%$'\n'*}; steps 2-5 are not compared, since every round-off token\
 of the solver moves with the last bits of GEMS3K's p_eq"
  else
    echo "FAIL another bridge (md5 ${md5:0:12}..., the excerpt's $own...):\
 the start-up and step 1, which no GEMS3K call reaches, ${out%%$'\n'*}"
  fi
}

