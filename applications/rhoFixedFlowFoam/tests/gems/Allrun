# copy of the solver sources without tests, documentation and build objects
copySources() {
  rm -rf "$1"
  mkdir -p "$1"
  (cd "$SOLVER_DIR" && tar -c --exclude=./tests --exclude=./doc \
    --exclude="./Make/linux*" --exclude="./utilities/*/Make/linux*" .) \
    | tar -x -C "$1"
}

# the carrier generator of tests/phaseChange, rebuilt when its source or
# OpenFOAM changes
buildMakeCarrier() {
  local key
  key="$WM_PROJECT_DIR $(cat "$PC_SRC"/makeCarrier/makeCarrier.C \
    "$PC_SRC"/makeCarrier/Make/* | md5sum | cut -d' ' -f1)"
  if [ -x "$MAKE_CARRIER" ] \
    && [ "$(cat "$GE_DIR/bin-carrier/key" 2>/dev/null)" = "$key" ]
  then
    return 0
  fi
  rm -rf "$GE_DIR/makeCarrier" "$GE_DIR/bin-carrier"
  mkdir -p "$GE_DIR/bin-carrier"
  cp -r "$PC_SRC/makeCarrier" "$GE_DIR/makeCarrier"
  (cd "$GE_DIR/makeCarrier" && FOAM_USER_APPBIN=$GE_DIR/bin-carrier wmake) \
    > "$GE_DIR/log.makeCarrier" 2>&1 || {
      echo "Building makeCarrier failed, see $GE_DIR/log.makeCarrier" >&2
      return 1
    }
  echo "$key" > "$GE_DIR/bin-carrier/key"
}

# blockCase <template of tests/phaseChange> <destination> [<command> ...]:
# copy, run the optional command in the copy, blockMesh, carrier
blockCase() {
  local template=$1 dst=$2
  shift 2
  rm -rf "$dst"
  cp -r "$PC_SRC/$template" "$dst" \
    && (cd "$dst" && { [ $# -eq 0 ] || "$@"; } \
        && blockMesh > log.blockMesh 2>&1 \
        && "$MAKE_CARRIER" > log.makeCarrier 2>&1) \
    || { echo "Setting up $dst failed" >&2; return 1; }
  touch "$dst/case.foam"
}

# edit <file> <sed expression> <pattern that must match afterwards>
edit() {
  sed -i -E "$2" "$1" && grep -q -E "$3" "$1" \
    || { echo "Editing $1 with '$2' failed" >&2; return 1; }
}

# blockCase hook: the hot channel, 1150 -> 450 K
hotCarrier() {
  edit system/carrierDict 's/^Tin +1000;/Tin       1150;/; s/^Tout +400;/Tout      450;/' \
    '^Tout +450;'
}

# the inventory sample of the channel (the boat of M5)
BOAT='  boat {
    pair          PbI2_g;
    selection     { boat { action use; source box; box (0.01 0.002 -1) (0.02 0.0028 1); } }
    mode          inventory;
    amount        4.84e-6;
    areaPerVolume 4000;
    removeTime    0.25;
  }'

# gemsDict <case> <equilibrium: table | frozen | local> [GEMSCoeffs entries]:
# model HKS with the Gurvich table (copied) and, for GEMS, the PbI2-He
# system (linked as constant/gems), the boat, the profiles
gemsDict() {
  local c=$1 mode=$2 extra=${3:-}
  cp "$PV_TABLE" "$c/constant/" && ln -sfn "$GEMS_SYSTEM" "$c/constant/gems" \
    || return 1
  {
    cat <<EOF
FoamFile {version 2.0; format ascii; class dictionary; object thermochemistryProperties;}

model HKS;

pairs {
  PbI2_g {
    condensed PbI2_s;
    vapourPressure {
      file          "<constant>/pv_PbI2_phases.csv";
      phases        ("PbI2(cr)" "PbI2(l)");
      units         log10Pa;
      interpolation logInverseT;
      outOfRange    extrapolate;
    }
    gems {
      gas          "PbI2(g)";
      condensates  ("PbI2(cr)" "PbI2(l)");
      elements     { Pb 1; I 2; }
      excess       { I 1e-6; }
    }
  }
}

interface {
  patches (WALL);
}

EOF
    if [ "$mode" = table ]
    then
      echo 'HKSCoeffs { accommodation 1; Ce 1; kineticScale 1; equilibrium table; }'
    else
      echo 'HKSCoeffs { accommodation 1; Ce 1; kineticScale 1; equilibrium GEMS; }'
      echo
      echo 'GEMSCoeffs {'
      echo '  system            "<constant>/gems/PbI2He-dat.lst";'
      echo "  mode              $mode;"
      echo '  carrier           "He(g)";'
      if [ "$mode" = frozen ]
      then
        echo '  referenceComposition { He 1; Pb 1e-3; I 2.000002e-3; }'
      else
        echo '  minMoleFraction   1e-6;'
        echo '  updateInterval    1;'
      fi
      echo '  minTemperature    500;'
      echo '  maxLog10Deviation 0.01;'
      echo '  writeEquilibriumField yes;'
      [ -n "$extra" ] && echo "$extra"
      echo '}'
    fi
    cat <<EOF

balance { nGuard 3; guardTolerance 1e-12; }

samples {
$BOAT
}

profiles {
  axis       (1 0 0);
  origin     (0 0 0);
  bins       { native { min 0; max 0.1; nBins 100; } }
  times      (0.1 0.2 0.3);
  onset      { fraction 0.01; search fromInlet; }
  observable wall;
}
EOF
  } > "$c/constant/thermochemistryProperties"
}

# the Final solve of the channel at 1e-14 (plan section 28, item 8)
finalTolerance() {
  python3 - "$1/system/fvSolution" <<'EOF'
import re, sys
p = sys.argv[1]
s = open(p).read()
s2 = re.sub(r'(Y_PbI2_gFinal\s*\{[^}]*?tolerance\s+)1e-12;', r'\g<1>1e-14;', s)
if s2 == s:
    raise SystemExit('no Final tolerance 1e-12 in ' + p)
open(p, 'w').write(s2)
EOF
}

# channel <case> <equilibrium> [GEMSCoeffs entries]: the GEMS channel
channel() {
  blockCase channel "$1" && gemsDict "$1" "$2" "${3:-}" \
    && finalTolerance "$1" && setControl "$1" endTime 0.35
}

# decomposeWith <case> <n> <method and coeffs>
decomposeWith() {
  local c=$1 n=$2 method=$3
  requireCaseDir "$c" || return 1
  cat > "$c/system/decomposeParDict" <<EOF
FoamFile{version 2.0; format ascii; class dictionary; object decomposeParDict;}

numberOfSubdomains $n;
$method
EOF
  (cd "$c" && decomposePar -force > log.decomposePar 2>&1)
}

# restartCopy <continuous> <restart> <time>: the files of <time> of the
# continuous run, started from it
restartCopy() {
  local src=$1 dst=$2 t=$3
  rm -rf "$dst"
  mkdir -p "$dst"
  cp -a "$src"/system "$src"/constant "$src"/0 "$src"/case.foam "$src/$t" \
    "$dst"/ && setControl "$dst" startFrom latestTime
}

# expectFatal <id> <text> <exe> <case> <message>: the run stops with a
# FatalIOError and the message
expectFatal() {
  local id=$1 text=$2 exe=$3 c=$4 message=$5
  if runSerial "$c" "$exe"
  then
    result "$id" FAIL "$text: the run did not stop ($c/log)"
  elif grep -q 'FOAM FATAL IO ERROR' "$c/log" \
    && grep -q -F -- "$message" "$c/log"
  then
    result "$id" PASS "$text: FatalIOError with '$message'"
  else
    result "$id" FAIL "$text: stopped without a FatalIOError with\
 '$message' ($c/log)"
  fi
}

# ledger <case> [<balance file>]: the closure <= 1e-13 of the reference in
# every step and |solverDefect| <= 1e-11 of it at the end, the M5 level
# (plan section 35, item B); prints both, returns 1 when one is not met
ledger() {
  local f=${2:-$1/$BALANCE} c d s1 s2
  c=$($PCCHECKS closure "$f" 1e-13)
  s1=$?
  d=$($PCCHECKS defect "$f" 1e-11)
  s2=$?
  echo "${c#*: }; ${d#*: }"
  [ $s1 -eq 0 ] && [ $s2 -eq 0 ]
}

# the largest of the 1-minute loads of the sampler's file and the given ones
maxLoad() {
  python3 - "$@" <<'EOF'
import sys
values = [float(x) for x in sys.argv[2:]]
try:
    values += [float(x) for x in open(sys.argv[1]).read().split()]
except OSError:
    pass
print(max(values))
EOF
}

# a run of the bridge build (serial)
runGems() {
  runSerial "$1" "$GEMS_EXE" "${2:-log}"
}

# withFaultBridge <command ...>: the command with the fault-injecting bridge
# loaded instead of the real one (its environment: LESTO_TEST_* set by the
# caller)
withFaultBridge() {
  env LD_LIBRARY_PATH="$FAULT_DIR:${LD_LIBRARY_PATH:-}" \
    LESTO_TEST_REAL_BRIDGE="$BRIDGE/libgemsbridge.so" "$@"
}


#------------------------------------------------------------------------------
# M9.3b, second line (needs no bridge): the load sampler of the timing run
# ends with its script.  A script runs it (or, as the control, the loop
# without a check of its parent that it replaced) and waits; it is
# terminated (TERM: its trap stops the sampler) or killed (KILL: no trap,
# the sampler sees its parent gone).  Afterwards no sampler may live but the
# control's, which the test stops.  The control ends by itself after 30 s,
# and the test's own traps stop what it started when it is interrupted
# (samplerCleanup), so that the test leaves no orphan either (plan section
# 35, item W; the control was an endless loop).
#------------------------------------------------------------------------------

# samplerCleanup <directory of samplerTest>: stops the scripts, samplers and
# controls of samplerTest that still run, by the PIDs they recorded, each
# only while its command line names the test's script (a PID is never
# killed once another process may have taken it over); the sleeps the
# scripts wait on end by themselves within 60 s
samplerCleanup() {
  local f pid
  for f in "$1"/child.* "$1"/pid.*
  do
    pid=$(cat "$f" 2>/dev/null)
    [ -n "$pid" ] && { tr '\0' ' ' < "/proc/$pid/cmdline"; } 2>/dev/null \
      | grep -q -F "$1/script" && kill "$pid" 2>/dev/null
  done
  return 0
}

samplerTest() {
  local d=$GE_DIR/samplerTest kind child pid n left= samples=
  rm -rf "$d"
  mkdir -p "$d"
  cat > "$d/script" <<EOF
source "$TESTS_DIR/functions"
if [ "\$1" = control ]
then
  ( for i in \$(seq 30); do sleep 1; cut -d' ' -f1 /proc/loadavg >> "$d/load.\$1"; done ) &
  SAMPLER=\$!
else
  startLoadSampler "$d/load.\$1"
fi
echo "\$SAMPLER" > "$d/pid.\$1"
sleep 60 &
echo \$! > "$d/wait.\$1"
wait \$!
EOF
  trap "samplerCleanup '$d'" EXIT
  trap "samplerCleanup '$d'; trap - EXIT; exit 130" INT
  trap "samplerCleanup '$d'; trap - EXIT; exit 143" TERM
  for kind in TERM KILL control
  do
    bash "$d/script" "$kind" > "$d/out.$kind" 2>&1 &
    child=$!
    echo "$child" > "$d/child.$kind"
    for n in $(seq 100)
    do
      [ -s "$d/wait.$kind" ] && break
      sleep 0.1
    done
    sleep 3
    if [ "$kind" = TERM ]
    then
      kill -TERM "$child"
    else
      kill -KILL "$child"
    fi
    wait "$child" 2>/dev/null
    sleep 5
    pid=$(cat "$d/pid.$kind" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
    then
      left+="${left:+ }$kind"
      kill "$pid" 2>/dev/null
    fi
    kill "$(cat "$d/wait.$kind" 2>/dev/null)" 2>/dev/null
    samples+="${samples:+, }$kind $(wc -l < "$d/load.$kind" 2>/dev/null || echo 0)"
  done
  trap - EXIT INT TERM
  echo "samples taken: $samples; sampler alive 5 s after its script ended:" \
       "${left:-none}"
  [ "$left" = control ]
}
samplerOut=$(samplerTest)
samplerStatus=$?
check M9.3b "the load sampler of the timing run ends with its script (plan\
 section 35, items K and W): a script terminated (TERM) and one killed\
 (KILL) leave no sampler, the loop it replaced (control, bounded to 30 s)\
