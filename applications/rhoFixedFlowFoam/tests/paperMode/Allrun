#------------------------------------------------------------------------------
# Helpers
#------------------------------------------------------------------------------

# edit <file> <sed expression> <pattern that must match afterwards>
edit() {
  sed -i -E "$2" "$1" && grep -q -E "$3" "$1" \
    || { echo "Editing $1 with '$2' failed" >&2; return 1; }
}

# the number of lines of a log that match a pattern
count() {
  grep -c -E "$2" "$1" 2>/dev/null
}

# decomposeWith <case> <n> <method and coeffs> [decomposePar options]
decomposeWith() {
  local c=$1 n=$2 method=$3
  shift 3
  requireCaseDir "$c" || return 1
  cat > "$c/system/decomposeParDict" <<EOF
FoamFile{version 2.0; format ascii; class dictionary; object decomposeParDict;}

numberOfSubdomains $n;
$method
EOF
  (cd "$c" && decomposePar -force "$@" > log.decomposePar 2>&1)
}

# case014 <destination> [<own dynamicCode: yes>]: a copy of run/014 (makeCase)
# with its carrier written by setFrozenCarrier into 0
case014() {
  local dst=$1 own=${2:-no}
  makeCase 014 "$dst" || return 1
  if [ "$own" = yes ]
  then
    rm -f "$dst/dynamicCode"
    mkdir -p "$dst/dynamicCode"
  fi
}

# carrier <case>: setFrozenCarrier into the start time
carrier() {
  requireCaseDir "$1" || return 1
  (cd "$1" && "$CARRIER_EXE" > log.setFrozenCarrier 2>&1)
}

#==============================================================================
# M4long: tests/paperMode/longRuns (executed: Allrun may be edited meanwhile)
