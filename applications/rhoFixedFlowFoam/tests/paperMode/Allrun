#------------------------------------------------------------------------------
# M4.13: several interface patches (tests/paperMode/corners), the patches
# in both orders of the boundary file
#------------------------------------------------------------------------------
CORNERS=$PM_SRC/corners

# corners <destination> <distance> <order ABC|CBA>: the L-shaped channel,
# its mesh and its carrier at rest (makeCarrier), the layer distance set
corners() {
  local dst=$1 distance=$2 order=$3
  rm -rf "$dst"
  cp -r "$CORNERS" "$dst" || return 1
  edit "$dst/constant/thermochemistryProperties" \
    "s/^(  distance +)[^;]+;/\1$distance;/" "^  distance +$distance;" \
    || return 1
  if [ "$order" = CBA ]
  then
    python3 - "$dst/system/blockMeshDict" <<'EOF' || return 1
import re, sys
p = sys.argv[1]
s = open(p).read()
get = lambda n: re.search(r'^  %s +\{.*\n' % n, s, re.M).group(0)
a, b, c = get('WALLA'), get('WALLB'), get('WALLC')
assert s.count(a + b + c) == 1
open(p, 'w').write(s.replace(a + b + c, c + b + a))
EOF
  fi
  (cd "$dst" && blockMesh > log.blockMesh 2>&1 \
     && "$MAKE_CARRIER" > log.makeCarrier 2>&1) && touch "$dst/case.foam"
}

# patchOrder <case>: the interface patches in the order of its boundary file
patchOrder() {
  sed -n 's/^ *\(WALL[ABC]\)$/\1/p' "$1/constant/polyMesh/boundary" \
    | tr '\n' ' '
}

for d in 7.5e-5 1.25e-4
do
  for order in ABC CBA
  do
    c=$PM_DIR/corners-$order-$d
    corners "$c" "$d" "$order" && runSerial "$c" "$SOLVER_EXE" \
      || echo "corners $order $d failed ($c/log)"
  done
done
A=$PM_DIR/corners-ABC-7.5e-5
B=$PM_DIR/corners-CBA-7.5e-5
out1=$($CHECKS layerCounts "$A/log" distance 5 20000 1e-12); s1=$?
out2=$($CHECKS layerCounts "$B/log" distance 5 20000 1e-12); s2=$?
out3=$($CHECKS mdepPatches "$A/0.002/mDep_PbI2_s" WALLA,WALLC WALLB \
         "$B/0.002/mDep_PbI2_s"); s3=$?
out4=$($CHECKS mdepPatches "$B/0.002/mDep_PbI2_s" WALLA,WALLC WALLB); s4=$?
out5=$($PCCHECKS closure "$A/$BALANCE" 1e-13); s5=$?
check M4.13 "two interface patches meeting at a corner, distance 7.5e-5 m,\
 boundary orders ($(patchOrder "$A")) and ($(patchOrder "$B")): ${out1#OK: };\
 ${out2#OK: }; ${out3#OK: }; ${out4#OK: }; ${out5#*: }" \
  eval '[ $s1 -eq 0 ] && [ $s2 -eq 0 ] && [ $s3 -eq 0 ] && [ $s4 -eq 0 ] \
    && [ $s5 -eq 0 ]'

A=$PM_DIR/corners-ABC-1.25e-4
B=$PM_DIR/corners-CBA-1.25e-4
out1=$($CHECKS layerCounts "$A/log" distance 15 6666.67 1e-6); s1=$?
out2=$($CHECKS layerCounts "$B/log" distance 15 6666.67 1e-6); s2=$?
out3=$($CHECKS mdepPatches "$A/0.002/mDep_PbI2_s" "" WALLA,WALLB \
         "$B/0.002/mDep_PbI2_s"); s3=$?
out4=$($CHECKS samePatches "$A/0.002/mDep_PbI2_s" "$B/0.002/mDep_PbI2_s" \
         WALLA,WALLB,WALLC); s4=$?
corner=$($CHECKS patchValue "$A/0.002/mDep_PbI2_s" WALLC 0 2>/dev/null)
check M4.13 "three interface patches, distance 1.25e-4 m (the cell at the\
 re-entrant corner of WALLA and WALLB included), boundary orders\
 ($(patchOrder "$A")) and ($(patchOrder "$B")): ${out1#OK: }; ${out2#OK: };\
 ${out3#OK: }; ${out4#OK: }; mDep_ of the corner face of WALLC (the corner\
 cell maps to WALLB): ${corner:-unknown}" \
