#------------------------------------------------------------------------------
# refusedCarrier <name> <sed expression> <pattern after the edit> <message>:
# a copy of the wedge with its dictionary edited and no carrier; status 0
# when the utility stops with the message and writes nothing
refusedCarrier() {
  local c=$PM_DIR/wedge-refused-$1
  copyCase "$WEDGE" "$c" || return 1
  rm -f "$c"/0/{rho,U,p,T,phi}
  edit "$c/system/setFrozenCarrierDict" "$2" "$3" || return 1
  if carrier "$c"
  then
    echo "$1: the utility did not stop ($c/log.setFrozenCarrier)"
    return 1
  fi
  if ls "$c"/0/{rho,U,p,T,phi} > /dev/null 2>&1
  then
    echo "$1: it stopped but wrote a field ($c/0)"
    return 1
  fi
  echo "$1 stops: '$(grep -a -m1 -o "$4.*" "$c/log.setFrozenCarrier" \
    | cut -c1-90)...'"
  grep -a -q "$4" "$c/log.setFrozenCarrier"
}
