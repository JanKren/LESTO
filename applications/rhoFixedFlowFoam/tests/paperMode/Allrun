fatalChannel() {
  local c=$PM_DIR/fatal-$1
  channel "$c" "$2" > /dev/null 2>&1 && setControl "$c" endTime 0.002 \
    && echo "$c"
}
c=$(fatalChannel halfCell '  layer distance;\n  distance 3.5e-4;\n  wallResistance halfCell;') \
  && expectFatal M4.8 "halfCell with layer distance" "$c" \
       "wallResistance halfCell is not available with layer distance"
c=$(fatalChannel areaPerVolumeCell '  layer distance;\n  distance 3.5e-4;\n  areaPerVolume cell;') \
  && expectFatal M4.8 "areaPerVolume cell with layer distance" "$c" \
       "layer distance needs areaPerVolume layer (the default), not cell"
c=$(fatalChannel noDistance '  layer distance;') \
  && expectFatal M4.8 "layer distance without a distance entry" "$c" \
       "Entry 'distance' not found"
c=$(fatalChannel tooSmall '  layer distance;\n  distance 1e-6;') \
  && expectFatal M4.8 "a distance that selects no cell (1e-6 m)" "$c" \
       "or no cell centre lies within the distance"
c=$PM_DIR/fatal-restartDistance
restartCopy "$CHD" "$c" 0.1 \
  && edit "$c/constant/thermochemistryProperties" \
       "s/^  distance 3.5e-4;/  distance 4e-4;/" "^  distance 4e-4;" \
  && expectFatal M4.8 "restart of the distance channel from 0.1 with distance\
 4e-4" "$c" "    distance 0.0004 (written with 0.00035)"
c=$PM_DIR/fatal-restartRule
restartCopy "$CHD" "$c" 0.1 \
  && edit "$c/constant/thermochemistryProperties" \
       "s/^  layer distance;/  layer faceCells;/" "^  layer faceCells;" \
  && expectFatal M4.8 "restart of the distance channel with layer faceCells"\
       "$c" "    layer faceCells (written with distance)"
c=$PM_DIR/fatal-restartRuleBack
restartCopy "$CHF" "$c" 0.1 \
  && edit "$c/constant/thermochemistryProperties" \
       "s/^  layer faceCells;/  layer distance;\n  distance 3.5e-4;/" \
       "^  distance 3.5e-4;" \
  && expectFatal M4.8 "restart of the faceCells channel with layer distance"\
       "$c" "    layer distance (written with faceCells)"

