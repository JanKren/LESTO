out1=$($CHECKS explicitRemainder "$DRIFT/log" 20); s1=$?
out2=$($CHECKS explicitRemainder "$DRIFTF/log" 20); s2=$?
out3=$($PCCHECKS closure "$DRIFTF/$BALANCE" 2e-15); s3=$?
