#------------------------------------------------------------------------------
# M4.18: the face-flux correction in flux form (review of M4, round 3; plan
# section 29, item 2).  The transport matrix of the paired species carries
# the non-orthogonal correction of its laplacian as a face-flux correction
# (the species is fluxRequired) and in its source.  matrixDefect.H enters
# its face values, each internal face once with opposite signs, and keeps
# of the source only the explicit remainder E = b - fl(s + c), 0 for the
# solver's schemes: the closure changes by exactly 0 for the correction.
# The build before kept b - s, whose sum over the cells telescopes only to
# round-off (up to 1.7e-24 kg per step unbooked on this pipe), and printed no
# remainder.  Both layer rules on the drift pipe of M4.15 (non-orthogonal up
# to about 30 degrees); positive control: Gauss linearUpwind on the channel,
# whose explicit correction OpenFOAM adds to the source only (no face
# values in the matrix), leaves a remainder.
#
# The report of E alone cannot see how the defect itself is formed (M4
# review carry-over, plan section 30, item 14; section 33).  The transport
# identity D = sum_c r_c + dM/dt + sum_p F_p - sum_c E_c, with the cell
# defects of the ledger's own code accumulated and summed exactly
# (matrixDefect.H transportIdentity), is 0 to the rounding of exact sums in
# flux form and the double-precision residue of V div(C) in source form.
# Negative control: a copy of the sources whose cell defect keeps the
# correction in source form while the report of E is unchanged (checks.py
# sourceFormMutant), built into the work area when the sources change
# (about 2 min) and run on the drift pipe with layer distance: it passes
# the check of E but violates the identity.
#------------------------------------------------------------------------------
MUTANT_DIR=$PM_DIR/sourceFormMutant
MUTANT_EXE=$MUTANT_DIR/bin/rhoFixedFlowFoam

# buildSourceFormMutant: the copy (without tests, doc, utilities and build
# objects), its matrixDefect.H edited, built with wmake into MUTANT_DIR/bin;
# reused while the sources, checks.py and OpenFOAM are unchanged
buildSourceFormMutant() {
  local key
  key=$({ echo "$WM_PROJECT_DIR"; md5sum < "$PM_SRC/checks.py"
          (cd "$SOLVER_DIR" && find . -path ./tests -prune -o -path ./doc \
             -prune -o -path ./utilities -prune -o -path './Make/linux*' \
             -prune -o -type f -print | LC_ALL=C sort | xargs md5sum); } \
        | md5sum | cut -d' ' -f1)
  if [ -x "$MUTANT_EXE" ] \
    && [ "$(cat "$MUTANT_DIR/bin/key" 2>/dev/null)" = "$key" ]
  then
    return 0
  fi
  rm -rf "$MUTANT_DIR"
  mkdir -p "$MUTANT_DIR/src" "$MUTANT_DIR/bin"
  (cd "$SOLVER_DIR" && tar -c --exclude=./tests --exclude=./doc \
    --exclude=./utilities --exclude="./Make/linux*" .) \
    | tar -x -C "$MUTANT_DIR/src" \
    && $CHECKS sourceFormMutant "$MUTANT_DIR/src/matrixDefect.H" \
         > "$MUTANT_DIR/log.sourceFormMutant" 2>&1 \
    && (cd "$MUTANT_DIR/src" && FOAM_USER_APPBIN=$MUTANT_DIR/bin wmake) \
         > "$MUTANT_DIR/log.wmake" 2>&1 \
    && [ -x "$MUTANT_EXE" ] && echo "$key" > "$MUTANT_DIR/bin/key"
}

DRIFTF=$PM_DIR/pipe-drift-faceCells
driftPipe "$DRIFTF" faceCells || echo "the drift pipe failed ($DRIFTF/log)"
CHLU=$PM_DIR/channel-linearUpwind
channel "$CHLU" "$DISTANCE" && setControl "$CHLU" endTime 0.01 \
  && edit "$CHLU/system/fvSchemes" \
       's/Gauss SuperBee;/Gauss linearUpwind grad(Y_PbI2_g);/' \
