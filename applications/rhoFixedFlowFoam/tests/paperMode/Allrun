}

# channel <destination> <layer entries>: the channel of tests/phaseChange
# (blockMesh, the frozen plug flow of makeCarrier), the given interface
# entries, tight solves (PBiCGStab 1e-15, relTol 0, no Final dictionary)
# with 21 forced correctors per step (nCorr 20 and an outer tolerance of
# 1e-12, which the correctors do not reach: every step ends at the
# corrector limit, 'NOT converged', the initial residual of the last
# corrector 6e-8 in the median step of channel-distance, between 2.5e-11
# and 1.5e-5, as the lagged SuperBee limiter changes the matrix from one
# corrector to the next; the condition of M2.4a-c, not a converged loop;
# review of M4, round 2), the mDep_ function object and a profiles
# dictionary
channel() {
  local dst=$1 entries=$2
  rm -rf "$dst"
  cp -r "$PC_SRC/channel" "$dst" || return 1
  edit "$dst/constant/thermochemistryProperties" \
    "s/^  patches \(WALL\);/  patches (WALL);\n$entries/" "patches \(WALL\);" \
    || return 1
  cat >> "$dst/constant/thermochemistryProperties" <<'EOF'

profiles {
  bins { native { nBins 100; } coarse { width 0.0075; } }
  times (0.03 0.1);
  observable wall;
}
EOF
  cat > "$dst/system/fvSolution" <<'EOF'
FoamFile {version 2.0; format ascii; class dictionary; object fvSolution;}

solvers {
  Y_PbI2_g {solver PBiCGStab; preconditioner DILU; tolerance 1e-15; relTol 0;}
  Y_PbI2_s {solver diagonal;}
}
EOF
  setSpeciesControl "$dst" tolerance 1e-12 \
    && setSpeciesControl "$dst" nCorr 20 \
    && withMdep "$dst" \
    && (cd "$dst" && blockMesh > log.blockMesh 2>&1 \
        && "$MAKE_CARRIER" > log.makeCarrier 2>&1) \
    && touch "$dst/case.foam"
}

# rowsSplit <case>: cellDecomposition of the channel by cell rows (100 cells
# per row, 24 rows): the first row at each wall on its own rank (0 and 3),
# the rows between on ranks 1 and 2
rowsSplit() {
  python3 - "$1/constant/cellDecomposition" <<'EOF'
import sys
ranks = []
for c in range(2400):
    j = c//100
    ranks.append(0 if j == 0 else 1 if j <= 11 else 2 if j <= 22 else 3)
with open(sys.argv[1], 'w') as f:
    f.write('FoamFile{version 2.0; format ascii; class labelList; '
            'object cellDecomposition;}\n%d\n(\n%s\n)\n'
            % (len(ranks), '\n'.join(map(str, ranks))))
EOF
}

# rows3Split <case>: cellDecomposition of the channel for a layer of three
# rows per wall: the rows 0, 1 and 2 at the lower wall on ranks 0, 1 and 2,
# the other rows on rank 3, so that every face of the lower wall receives
# the elements of two other ranks
rows3Split() {
  python3 - "$1/constant/cellDecomposition" <<'EOF'
import sys
ranks = []
for c in range(2400):
    j = c//100
    ranks.append(j if j <= 2 else 3)
with open(sys.argv[1], 'w') as f:
    f.write('FoamFile{version 2.0; format ascii; class labelList; '
            'object cellDecomposition;}\n%d\n(\n%s\n)\n'
            % (len(ranks), '\n'.join(map(str, ranks))))
EOF
}

# twoWaySplit <case>: cellDecomposition of the channel whose nearest-face
# map runs both ways between ranks 0 and 1: the rows 0 and 22 on rank 0, the
# rows 1 and 23 on rank 1 (the second row of each wall maps to the faces of
# the other rank), the rows between on ranks 2 and 3 (review of M4, round 3)
twoWaySplit() {
  python3 - "$1/constant/cellDecomposition" <<'EOF'
import sys
ranks = []
for c in range(2400):
    j = c//100
    ranks.append(0 if j in (0, 22) else 1 if j in (1, 23) else 2 if j <= 11
                 else 3)
with open(sys.argv[1], 'w') as f:
    f.write('FoamFile{version 2.0; format ascii; class labelList; '
            'object cellDecomposition;}\n%d\n(\n%s\n)\n'
            % (len(ranks), '\n'.join(map(str, ranks))))
EOF
}

# layersApart <case>: cellDecomposition of the pipe: rank 0 the first cell
# layer (R - r < 6e-5 m: the first layer lies at 2.9e-5 to 4e-5 m, the
# second at 9.8e-5 m), the other cells by x on ranks 1 (x < 0.2), 2 (x <
# 0.45) and 3; cell centres from postProcess writeCellCentres
layersApart() {
  (cd "$1" && postProcess -func writeCellCentres -time 0 \
     > log.writeCellCentres 2>&1) || return 1
  python3 - "$1" <<EOF
import os, sys
sys.path.insert(0, '$PC_SRC')
import checks as pc
case = sys.argv[1]
C = [pc.readScalarField(os.path.join(case, '0', 'C' + x))[0] for x in 'xyz']
ranks = []
for x, y, z in zip(*C):
    r = (y*y + z*z)**0.5
    ranks.append(0 if 2.4e-3 - r < 6e-5 else 1 if x < 0.2 else 2 if x < 0.45
                 else 3)
for x in 'xyz':
    os.remove(os.path.join(case, '0', 'C' + x))
os.remove(os.path.join(case, '0', 'C'))
with open(os.path.join(case, 'constant', 'cellDecomposition'), 'w') as f:
    f.write('FoamFile{version 2.0; format ascii; class labelList; '
            'object cellDecomposition;}\n%d\n(\n%s\n)\n'
            % (len(ranks), '\n'.join(map(str, ranks))))
print('layersApart: cells per rank', [ranks.count(k) for k in range(4)])
EOF
}

# copyCase <source> <destination>: system, constant (links kept), 0 and the
# marker of a case, without its results
copyCase() {
  rm -rf "$2"
  mkdir -p "$2"
  cp -a "$1/system" "$1/constant" "$1/0" "$2/" \
    && touch "$2/case.foam" \
    && { [ ! -e "$1/dynamicCode" ] || cp -a "$1/dynamicCode" "$2/"; }
}

# restartCopy <continuous> <restart> <time>: every file of <time> of the
# continuous run (and of its processor directories)
restartCopy() {
  local src=$1 dst=$2 t=$3 d
  rm -rf "$dst"
  mkdir -p "$dst"
  cp -a "$src"/system "$src"/constant "$src"/0 "$src"/case.foam "$dst"/
  if ls -d "$src"/processor* > /dev/null 2>&1
  then
    for d in "$src"/processor*
    do
      mkdir -p "$dst/$(basename "$d")"
      cp -a "$d/constant" "$d/0" "$d/$t" "$dst/$(basename "$d")"/
    done
  else
    cp -a "$src/$t" "$dst"/
  fi
  setControl "$dst" startFrom latestTime
}

# expectFatal <id> <text> <case> <message>: the run fails with the message
expectFatal() {
  local id=$1 text=$2 c=$3 message=$4
  if runSerial "$c" "$SOLVER_EXE"
  then
    result "$id" FAIL "$text: the run did not stop ($c/log)"
  elif grep -q -F -- "$message" "$c/log"
  then
    result "$id" PASS "$text: stops with '$message'"
  else
    result "$id" FAIL "$text: stopped without '$message' ($c/log)"
  fi
}

