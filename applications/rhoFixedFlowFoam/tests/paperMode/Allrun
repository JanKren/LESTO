#------------------------------------------------------------------------------
# M4.6: the sources compile against OpenFOAM v2606 (a copy)
#------------------------------------------------------------------------------
V2606=${LESTO_OPENFOAM_V2606:-}
if [ -n "$V2606" ] && [ -f "$V2606/etc/bashrc" ]
then
  B=$PM_DIR/v2606
  rm -rf "$B"
  mkdir -p "$B/src" "$B/bin"
  # the copy without the build directories of any platform (Make/linux*;
  # review of M4, round 1: './Make/*/' matched nothing, so the copy carried
  # the v2412 objects, and a v2606 build of the same WM_OPTIONS relinked
  # them without compiling); wclean in the copy as well, below
  (cd "$SOLVER_DIR" && tar -c --exclude=./tests --exclude=./doc \
    --exclude="./Make/linux*" --exclude="./utilities/*/Make/linux*" .) \
    | tar -x -C "$B/src"
  # the compile option of the installation's build (e.g. a Debug-only one)
  option=${LESTO_OPENFOAM_V2606_OPTION:-$(ls "$V2606/platforms" 2>/dev/null \
    | sed -n 's/^linux64GccDPInt32\(Opt\|Debug\)$/\1/p' | head -1)}
  env -i HOME="$HOME" PATH=/usr/bin:/bin USER="$USER" bash -c "
    set +u
    source '$V2606/etc/bashrc' WM_COMPILE_OPTION=${option:-Opt} \
      > /dev/null 2>&1
    cd '$B/src' && export FOAM_USER_APPBIN='$B/bin'
    echo \"OpenFOAM \$WM_PROJECT_VERSION \$WM_OPTIONS\"
    wclean > /dev/null 2>&1; wclean utilities/setFrozenCarrier > /dev/null 2>&1
    wmake && wmake utilities/setFrozenCarrier
  " > "$B/log.wmake" 2>&1
  status=$?
  version=$(head -1 "$B/log.wmake")
  warnings=$(countWarnings "$B/log.wmake")
  missing=""
  for src in $(solverSources) $(utilitySources)
  do
    compiled "$src" "$B/log.wmake" || missing+=" $src"
  done
  check M4.6 "a copy of the sources (solver and setFrozenCarrier) compiles\
 and links against $V2606 ($version): exit $status, $warnings warnings,\
 every source of their Make/files compiled (not compiled:${missing:- none})\
 ($B/log.wmake)" eval '[ $status -eq 0 ] && [ "$warnings" -eq 0 ] \
    && [ -z "$missing" ] \
    && [ -x "$B/bin/rhoFixedFlowFoam" ] && [ -x "$B/bin/setFrozenCarrier" ]'
else
  result M4.6 NOTRUN "the compile on OpenFOAM v2606: set LESTO_OPENFOAM_V2606\
 to an OpenFOAM-v2606 installation (M0.4 on Merlin7 remains NOTRUN)"
fi

exit 0
