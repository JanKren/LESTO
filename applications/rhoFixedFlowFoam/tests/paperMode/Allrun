# the carrier generator of tests/phaseChange (the channel), rebuilt when its
# source or OpenFOAM changes
buildMakeCarrier() {
  local key
  key="$WM_PROJECT_DIR $(cat "$PC_SRC"/makeCarrier/makeCarrier.C \
    "$PC_SRC"/makeCarrier/Make/* | md5sum | cut -d' ' -f1)"
  if [ -x "$MAKE_CARRIER" ] \
    && [ "$(cat "$PM_DIR/bin/key" 2>/dev/null)" = "$key" ]
  then
    return 0
  fi
  rm -rf "$PM_DIR/makeCarrier" "$PM_DIR/bin"
  mkdir -p "$PM_DIR/bin"
  cp -r "$PC_SRC/makeCarrier" "$PM_DIR/makeCarrier"
  (cd "$PM_DIR/makeCarrier" && FOAM_USER_APPBIN=$PM_DIR/bin wmake) \
    > "$PM_DIR/log.makeCarrier" 2>&1 || {
      echo "Building makeCarrier failed, see $PM_DIR/log.makeCarrier" >&2
      return 1
    }
  echo "$key" > "$PM_DIR/bin/key"
}

# the surfaceFieldValue of mDep_PbI2_s on WALL, every step
MDEP_FO='functions {
  mDepWall {
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    writeControl    timeStep;
    writeInterval   1;
    writeFields     false;
    log             false;
    writePrecision  17;
    regionType      patch;
    name            WALL;
    operation       areaIntegrate;
    fields          (mDep_PbI2_s);
  }
}'
MDEP_DAT=postProcessing/mDepWall/0/surfaceFieldValue.dat

# withMdep <case>: the function object appended to controlDict
withMdep() {
