#------------------------------------------------------------------------------
# M4.15: the closure does not drift (review of M4, round 2; plan section 27,
# item 1).  The pipe of run/014 with its own solver settings, a background
# Y = 0.1 and steps of 0.1 s (20 steps on 4 ranks): the double-precision
# imbalance of the assembled transport matrix grows with D dt/h^2 of the
# wall cells (h = 57 um, D about 1e-4 m2/s: about 3000 here, 300 in the
# T5_60 runs of M4long), so 20 steps show it.  The binary before the fix
# (the row-form defect, the deposit rounding not booked) drifted linearly to
# 1.16e-14 of the reference in these 20 steps (the T5_60 run: 7.6e-13 in
# 6000 steps); with the fix 4.2e-16; the gate is 2e-15, a few ulp of the
# inventory.  The run prints the debug report of reportMatrixResidual (a
# diagnostic only: the solution and the booking are the same without it)
# for M4.18.
#------------------------------------------------------------------------------

# driftPipe <case> <layer> [<executable>]: the pipe of run/014 with a
# background Y = 0.1, 20 steps of 0.1 s on 4 ranks (simple (4 1 1)), the
# debug report on; run with the solver under test unless another
# executable is given (the negative control of M4.18)
driftPipe() {
  local c=$1 layer=$2 exe=${3:-$SOLVER_EXE}
  copyCase "$C014" "$c" && rm -f "$c/dynamicCode" \
    && ln -s "$DYNAMIC_CODE_DIR" "$c/dynamicCode" \
    && edit "$c/0/Y_PbI2_g" "s/^internalField +uniform 0;/internalField   uniform 0.1;/" \
         "^internalField +uniform 0.1;" \
    && edit "$c/constant/thermochemistryProperties" \
         "s/^(  layer +)distance;/\1$layer;/" "^  layer +$layer;" \
    && edit "$c/constant/thermochemistryProperties" \
         's/^(  guardTolerance .*)$/\1\n  reportMatrixResidual yes;/' \
         '^  reportMatrixResidual yes;' \
    && setControl "$c" deltaT 0.1 && setControl "$c" endTime 2 \
    && setControl "$c" writeControl timeStep \
    && setControl "$c" writeInterval 20 \
    && decomposeWith "$c" 4 "method simple; coeffs { n (4 1 1); }" \
    && runParallel "$c" "$exe" 4
}
