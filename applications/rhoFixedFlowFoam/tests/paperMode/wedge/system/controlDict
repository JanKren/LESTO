/*------------------------------------------------------------------------------

system/controlDict of tests/paperMode/wedge

------------------------------------------------------------------------------*/
FoamFile {version 2.0; format ascii; class dictionary; object controlDict;}

application       rhoFixedFlowFoam;
startFrom         latestTime;
startTime         0;
stopAt            endTime;
endTime           0.02;
deltaT            0.001;
writeControl      timeStep;
writeInterval     10;
purgeWrite        0;
writeFormat       binary;
writeCompression  off;
timeFormat        general;
timePrecision     6;
runTimeModifiable false;

speciesTransport {
  tolerance          1e-9;
  nCorr              10;
  writeFrozenFields  no;
}
