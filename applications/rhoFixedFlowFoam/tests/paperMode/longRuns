#------------------------------------------------------------------------------
# M4.5: Table 2, temperature-based column, both layer rules, the gate
# restated by the researcher (2026-10-02): |T_dep - T_paper| <= max(2 K,
# dT_bin), dT_bin the drop of the wall temperature across the native bin
# of the onset; the raw difference, dT_bin and the plain +-2 K comparison
# are printed (checks.py tdep; one line per case and rule).  A run that has not ended is evaluated at its latest
# profiles: the deposit is irreversible, so the interval of T_dep at the
# end of the experiment (checks.py tdepDecided) decides the criterion as
# soon as it lies within +-2 K (met) or entirely outside (not met); the
# run's stopping rule (BOUND_WIDTH) only narrows that interval further.
#------------------------------------------------------------------------------
table2() {
  local case=$1 expected=$2 tEnd=$3 rule c time out s
  for rule in distance faceCells
  do
    c=$PM_DIR/long/$case-$rule
    if ended "$case-$rule" > /dev/null
    then
      time=$(lastProfileTime "$c")
      out=$($CHECKS tdep "$c" "$time" "$tEnd" "$expected" 2 \
              "$case, layer $rule")
      s=$?
      check M4.5 "$out $(origin "$case-$rule")" [ $s -eq 0 ]
      continue
    fi
    time=$(lastProfileTime "$c" 2>/dev/null)
    # a run of the current key that has not ended (not one that failed, nor
    # a recorded run of another key: stale)
    if [ "${STATE[$case-$rule]}" = prepared ] && [ -n "$time" ]
    then
      out=$($CHECKS tdepDecided "$c" "$time" "$tEnd" "$expected" 2 \
              "$case, layer $rule (the run has not ended)")
      s=$?
      if [ $s -eq 0 ]
      then
        result M4.5 PASS "$out $(origin "$case-$rule")"
        continue
      elif [ $s -eq 2 ]
      then
        result M4.5 FAIL "$out $(origin "$case-$rule")"
        continue
      fi
      notEnded M4.5 "$out" "$case-$rule"
    else
      notEnded M4.5 "$case, layer $rule (Table 2: $expected K)" "$case-$rule"
    fi
  done
}
