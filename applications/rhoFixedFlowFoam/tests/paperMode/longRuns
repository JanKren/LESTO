#------------------------------------------------------------------------------
# M4.17: the closure of the long runs made with the current sources (review
# of M4, round 2; plan section 27, item 1): at most 1e-14 of the reference
# in every step of every such run, the drift gate at the length of the
# runs.  A run revalidated under the current key (made with older
# binaries) stands for the physics of the current sources, not for their
# ledger: its closure is printed, not gated (the runs made before the fix,
# with the row-form defect and the rounding of the stored condensate not
# booked, reached 7.6e-13 in T5_60 and 1.8e-14 to 8.2e-14 elsewhere).
# NOTRUN when no run was made with the current sources; FAIL when one of
# the runs failed.
#------------------------------------------------------------------------------

# revalidatedNow <id>: the run was revalidated under its current key
revalidatedNow() {
  local c=$PM_DIR/long/$1 key
  key=$(cat "$c/m4key" 2>/dev/null)
  grep -F 'revalidated: key' "$c/m4revalidated" 2>/dev/null \
    | grep -q -F -- "-> $key "
}

madeNow=()
reusedNow=()
notDone=()
for spec in "${LONG_RUNS[@]}"
do
  id=${spec%% *}
  if [ "${STATE[$id]}" != ended ]
  then
    notDone+=("$id")
  elif revalidatedNow "$id"
  then
    reusedNow+=("$id")
  else
    madeNow+=("$id")
  fi
done
text="the closure of the long runs made with the current sources, in every\
 step, limit 1e-14 of the reference"
others=""
if [ ${#reusedNow[@]} -gt 0 ]
then
  out=$($CHECKS closureRuns 1 \
          $(for id in "${reusedNow[@]}"; do echo "$PM_DIR/long/$id"; done))
  out=${out#*per run: }
  others+="; not gated, revalidated (made with older binaries, the closure"
  others+=" of their booking): ${out% (limit 1)}"
fi
if [ ${#notDone[@]} -gt 0 ]
then
  others+="; not ended: ${notDone[*]}"
fi
if [ ${#madeNow[@]} -gt 0 ]
then
  out=$($CHECKS closureRuns 1e-14 \
          $(for id in "${madeNow[@]}"; do echo "$PM_DIR/long/$id"; done))
  s=$?
  failedRuns=$(ended "${notDone[@]}" 2>/dev/null | grep -c 'the run failed')
  check M4.17 "$text: ${out#*per run: }$others" \
    eval '[ $s -eq 0 ] && [ "$failedRuns" -eq 0 ]'
elif ended "${notDone[@]}" > /dev/null || [ $? -ne 2 ]
then
  result M4.17 NOTRUN "$text: no run was made with the current sources$others"
else
  result M4.17 FAIL "$text: no run was made with the current sources$others"
fi

#------------------------------------------------------------------------------
# M4.20: the key of a run follows the mesh and the shell functions that set
# the run up (review of M4, round 3), as the cache keys of the regression
# gate do.  The key of the first run, against the same key with a stand-in
# mesh directory whose checksum differs, and with setupLong redefined (in a
# subshell); the old key of round 2 (without both) gave the same key in all
# three cases.  Nothing is changed but the stand-in directory.
#------------------------------------------------------------------------------
keyTest() {
  local spec=${LONG_RUNS[0]} dir=$PM_DIR/long/keytest k0 kMesh kSetup
  rm -rf "$dir"
  mkdir -p "$dir" && echo "a stand-in checksum" > "$dir/mesh.md5" || return 1
  k0=$(longKey "$spec")
  kMesh=$(MESH_DIR=$dir longKey "$spec")
  kSetup=$(setupLong() { return 1; }; longKey "$spec")
  rm -rf "$dir"
  echo "key ${k0:0:12}, with another mesh checksum ${kMesh:0:12}, with a" \
       "changed setupLong ${kSetup:0:12} (mesh.md5" \
       "$(cat "$MESH_DIR/mesh.md5"))"
  [ -n "$k0" ] && [ "$k0" != "$kMesh" ] && [ "$k0" != "$kSetup" ] \
    && [ "$kMesh" != "$kSetup" ]
}
