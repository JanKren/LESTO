case "$WM_PROJECT_VERSION" in
  2606|v2606)
    check M0.4 "compiles on OpenFOAM $WM_PROJECT_VERSION (builds M0.3a-c)" \
      [ -x "$EXE" ]
    ;;
  *)
    result M0.4 NOTRUN "compile on v2606: this OpenFOAM is" \
      "$WM_PROJECT_VERSION; run tests/Alltest M0 under v2606"
    ;;
